          "baseUrl": "https://gitlab.com",
          "gitUsername": "oauth2",
          "namespace": "acme/sites",
          "token": "glpat-example",
        },
        {
          "baseUrl": "https://gitlab.com",
          "frontedProjects": {
            "namespace": "acme/customers",
            "prefix": "gl-",
          },
          "gitUsername": "oauth2",
          "namespace": "acme/sites",
          "token": "glpat-example",
        },
      ],
      "properties": {
        "baseUrl": {
          "default": "https://gitlab.com",
          "description": "Base URL of the GitLab instance, without a trailing "/api/v4". Default "https://gitlab.com".",
          "format": "uri",
          "type": "string",
        },
        "frontedProjects": {
          "additionalProperties": false,
          "description": "Fronts projects that already exist outside \`namespace\`, addressed by project id instead of by name. A repository named <prefix><projectId> is project <projectId>, provided it lives under \`frontedProjects.namespace\`; createRepo and deleteRepo refuse such names with invalid_input, since the gateway did not create those projects and must not remove them. Absent: every name is a project in \`namespace\`.",
          "properties": {
            "namespace": {
              "description": "Full path of the group whose projects (at any depth below it) may be fronted, e.g. "acme/customers". A project id outside it answers repo_not_found, so the token's other projects stay unreachable.",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_.-]*(?:\\/[A-Za-z0-9_.][A-Za-z0-9_.-]*)*$",
              "type": "string",
            },
            "prefix": {
              "default": "gl-",
              "description": "Prefix of the reserved repository names that address an existing project by id: <prefix><projectId>, e.g. "gl-1234" for project 1234. 1–20 characters, starting with a letter and ending in "-". Default "gl-".",
              "maxLength": 20,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_.]*-$",
              "type": "string",
            },
          },
          "required": [
            "prefix",
            "namespace",
          ],
          "type": "object",
        },
        "gitUsername": {
          "default": "oauth2",
          "description": "HTTP Basic username sent with the token to git; GitLab ignores it for access tokens. Default "oauth2".",
          "minLength": 1,
          "type": "string",
        },
        "namespace": {
          "description": "Full path of the group the repositories live in, e.g. "acme/sites". A repository named <repo> is the project <namespace>/<repo>.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_.-]*(?:\\/[A-Za-z0-9_.][A-Za-z0-9_.-]*)*$",
          "type": "string",
        },
        "namespaceId": {
          "description": "Numeric id of that group. Absent: looked up from \`namespace\` the first time a repository is created.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "token": {
          "description": "A GitLab access token (personal, group or project access token, or OAuth) with the api, read_repository and write_repository scopes on the namespace. Secret: sent as a PRIVATE-TOKEN header to the API and as the HTTP Basic password to git.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "baseUrl",
        "token",
        "namespace",
        "gitUsername",
      ],
      "title": "GitLab backend configuration",
      "type": "object",
    },
    "GitLabCommitSummary": {
      "additionalProperties": false,
      "description": "The fields of a GitLab commit the backend uses to list history. GitLab does not report the tree id or exact message, so the commit objects themselves are fetched over git.",
      "examples": [
        {
          "id": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "parent_ids": [],
        },
      ],
      "properties": {
        "id": {
          "description": "The commit id.",
          "pattern": "^[0-9a-f]{40}$",
          "type": "string",
        },
        "parent_ids": {
          "description": "Parent ids in order.",
          "items": {
            "description": "A parent commit id.",
            "pattern": "^[0-9a-f]{40}$",
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "id",
        "parent_ids",
      ],
      "title": "GitLab commit summary",
      "type": "object",
    },
    "GitLabErrorBody": {
      "additionalProperties": false,
      "description": "The JSON body of a GitLab API error.",
      "examples": [
        {
          "message": "404 Project Not Found",
        },
        {
          "message": {
            "path": [
              "has already been taken",
            ],
          },
        },
      ],
      "properties": {
        "error": {
          "description": "A short error code or message, e.g. "insufficient_scope".",
          "type": "string",
        },
        "message": {
          "anyOf": [
            {
              "description": "A plain message such as "404 Project Not Found".",
              "type": "string",
            },
            {
              "additionalProperties": {
                "description": "What is wrong with it.",
                "items": {
                  "description": "One failure.",
                  "type": "string",
                },
                "type": "array",
              },
              "description": "Validation failures by field, e.g. {"path": ["has already been taken"]}.",
              "propertyNames": {
                "description": "The field that failed validation.",
                "type": "string",
              },
              "type": "object",
            },
          ],
          "description": "The error message; absent when GitLab sent only "error".",
        },
      },
      "title": "GitLab error body",
      "type": "object",
    },
    "GitLabGroup": {
      "additionalProperties": false,
      "description": "The fields of a GitLab group the backend uses.",
      "examples": [
        {
          "full_path": "acme/sites",
          "id": 42,
        },
      ],
      "properties": {
        "full_path": {
          "description": "Full path of the group.",
          "minLength": 1,
          "type": "string",
        },
        "id": {
          "description": "Numeric group id, used as namespace_id when creating projects.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
        "full_path",
      ],
      "title": "GitLab group",
      "type": "object",
    },
    "GitLabProject": {
      "additionalProperties": false,
      "description": "The fields of a GitLab project the backend uses; other fields are ignored.",
      "examples": [
        {
          "created_at": "2026-11-20T09:30:00.000Z",
          "default_branch": "main",
          "http_url_to_repo": "https://gitlab.com/acme/sites/acme-raw-content.git",
          "id": 1234,
          "marked_for_deletion_on": null,
          "path": "acme-raw-content",
          "path_with_namespace": "acme/sites/acme-raw-content",
        },
      ],
      "properties": {
        "created_at": {
          "description": "When the project was created, ISO 8601.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string",
        },
        "default_branch": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "The default branch; null or absent for an empty repository on some GitLab versions.",
        },
        "http_url_to_repo": {
          "description": "HTTPS clone URL of the repository, ending in ".git".",
          "format": "uri",
          "type": "string",
        },
        "id": {
          "description": "Numeric project id.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "marked_for_deletion_on": {
          "description": "Date the project is scheduled for deletion (delayed deletion); null or absent when it is not.",
          "type": [
            "string",
            "null",
          ],
        },
        "path": {
          "description": "The project's path segment, which is the repository name.",
          "minLength": 1,
          "type": "string",
        },
        "path_with_namespace": {
          "description": "Full path, "<namespace>/<path>".",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "id",
        "path",
        "path_with_namespace",
        "created_at",
        "http_url_to_repo",
      ],
      "title": "GitLab project",
      "type": "object",
    },
    "GitLabRef": {
      "additionalProperties": false,
      "description": "A branch or tag and the commit it names.",
      "examples": [
        {
          "commit": {
            "id": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
