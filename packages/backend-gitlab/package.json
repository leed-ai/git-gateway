{
  "name": "@leed-ai/git-gateway-backend-gitlab",
  "version": "0.1.2",
  "description": "git-gateway storage backend over a GitLab instance.",
  "keywords": [
    "cloudflare-workers",
    "git",
    "git-gateway",
    "gitlab",
    "storage-backend"
  ],
  "homepage": "https://github.com/leed-ai/git-gateway/tree/main/packages/backend-gitlab#readme",
  "bugs": {
    "url": "https://github.com/leed-ai/git-gateway/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leed-ai/git-gateway.git",
    "directory": "packages/backend-gitlab"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./gitlab-api": {
      "source": "./src/gitlab-api.ts",
      "types": "./dist/gitlab-api.d.ts",
      "default": "./dist/gitlab-api.js"
    },
    "./gitlab-backend": {
      "source": "./src/gitlab-backend.ts",
      "types": "./dist/gitlab-backend.d.ts",
      "default": "./dist/gitlab-backend.js"
    },
    "./gitlab-git-reads": {
      "source": "./src/gitlab-git-reads.ts",
      "types": "./dist/gitlab-git-reads.d.ts",
      "default": "./dist/gitlab-git-reads.js"
    },
    "./package-name": {
      "source": "./src/package-name.ts",
      "types": "./dist/package-name.d.ts",
      "default": "./dist/package-name.js"
    },
    "./schemas/gitlab-config": {
      "source": "./src/schemas/gitlab-config.ts",
      "types": "./dist/schemas/gitlab-config.d.ts",
      "default": "./dist/schemas/gitlab-config.js"
    },
    "./schemas/gitlab-responses": {
      "source": "./src/schemas/gitlab-responses.ts",
      "types": "./dist/schemas/gitlab-responses.d.ts",
      "default": "./dist/schemas/gitlab-responses.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "test:contract": "vp test test/contract/"
  },
  "dependencies": {
    "@leed-ai/git-gateway-contract": "workspace:*",
    "@leed-ai/git-gateway-core": "workspace:*"
  },
  "devDependencies": {
    "@leed-ai/git-gateway-repo-tools": "workspace:*",
    "@leed-ai/git-gateway-schema-docs": "workspace:*",
    "@leed-ai/git-gateway-testkit": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
