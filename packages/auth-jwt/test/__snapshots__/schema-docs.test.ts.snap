          "minimum": 0,
          "type": "number",
        },
      },
      "required": [
        "iss",
        "aud",
        "exp",
      ],
      "title": "JWT claims",
      "type": "object",
    },
    "JwtHeader": {
      "additionalProperties": {},
      "description": "The protected header of a signed JWT (RFC 7515 §4). Other members are allowed and ignored.",
      "examples": [
        {
          "alg": "RS256",
          "kid": "rsa-1",
          "typ": "JWT",
        },
      ],
      "properties": {
        "alg": {
          "description": "Signature algorithm; must be one the authenticator accepts.",
          "maxLength": 20,
          "minLength": 1,
          "type": "string",
        },
        "kid": {
          "description": "Id of the signing key in the issuer's JWK Set; absent when the set has one key.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "typ": {
          "description": "Media type, usually "JWT"; not checked.",
          "maxLength": 50,
          "type": "string",
        },
      },
      "required": [
        "alg",
      ],
      "title": "JWT header",
      "type": "object",
    },
    "OidcDiscovery": {
      "additionalProperties": {},
      "description": "The fields of <issuer>/.well-known/openid-configuration (OpenID Connect Discovery 1.0) the authenticator uses.",
      "examples": [
        {
          "issuer": "https://auth.example.com",
          "jwks_uri": "https://auth.example.com/.well-known/jwks.json",
        },
      ],
      "properties": {
        "issuer": {
          "description": "The provider's issuer identifier; must equal the configured issuer.",
          "minLength": 1,
          "type": "string",
        },
        "jwks_uri": {
          "description": "Where the provider publishes its JWK Set.",
          "format": "uri",
          "type": "string",
        },
      },
      "required": [
        "issuer",
        "jwks_uri",
      ],
      "title": "OIDC discovery document",
      "type": "object",
    },
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
}
`;
