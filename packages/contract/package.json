{
  "name": "@leed-ai/git-gateway-contract",
  "version": "0.0.0",
  "description": "Zod schemas and the RPC interface of git-gateway (the API contract), with an in-memory reference implementation.",
  "keywords": [
    "cloudflare-workers",
    "contract",
    "git",
    "git-gateway",
    "rpc",
    "zod"
  ],
  "homepage": "https://github.com/leed-ai/git-gateway/tree/main/packages/contract#readme",
  "bugs": {
    "url": "https://github.com/leed-ai/git-gateway/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leed-ai/git-gateway.git",
    "directory": "packages/contract"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./health": {
      "source": "./src/health.ts",
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./package-name": {
      "source": "./src/package-name.ts",
      "types": "./dist/package-name.d.ts",
      "default": "./dist/package-name.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "test:contract": "vp test test/contract/"
  },
  "devDependencies": {
    "@leed-ai/git-gateway-repo-tools": "workspace:*",
    "@leed-ai/git-gateway-schema-docs": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
