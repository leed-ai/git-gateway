    "GatewayError.stale_head": {
      "additionalProperties": false,
      "description": "The branch head is not the head the caller expected; nothing was written. Re-read and retry.",
      "examples": [
        {
          "code": "stale_head",
          "details": {
            "actualHead": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "branch": "main",
            "expectedHead": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          },
          "message": "Branch head moved",
        },
      ],
      "properties": {
        "code": {
          "const": "stale_head",
          "description": "The branch head is not the head the caller expected; nothing was written. Re-read and retry.",
          "type": "string",
        },
        "details": {
          "additionalProperties": false,
          "description": "Machine-readable facts about the stale_head error.",
          "properties": {
            "actualHead": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Sha",
                },
                {
                  "type": "null",
                },
              ],
              "description": "The current head; null when the branch does not exist.",
            },
            "branch": {
              "$ref": "#/$defs/BranchName",
              "description": "The branch the write targeted.",
            },
            "expectedHead": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Sha",
                },
                {
                  "type": "null",
                },
              ],
              "description": "The head the caller expected; null when it expected no branch.",
            },
          },
          "required": [
            "branch",
            "expectedHead",
            "actualHead",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "stale_head error",
      "type": "object",
    },
    "GatewayError.storage_unavailable": {
