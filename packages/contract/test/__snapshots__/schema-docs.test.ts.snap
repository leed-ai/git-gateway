              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "Text git shows the user when this rule refuses an update, e.g. "main is protected"; one line of 1–200 characters. Null (the default) uses a message naming the ref and what was refused.",
        },
        "pattern": {
          "$ref": "#/$defs/RefPattern",
          "description": "The refs this rule governs.",
        },
        "pushers": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalSelector",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "Who may update matching refs at all; null (the default) lets every principal the Authorizer allowed to write.",
        },
      },
      "required": [
        "pattern",
        "pushers",
        "create",
        "delete",
        "forcePush",
        "message",
      ],
      "title": "Branch rule",
      "type": "object",
    },
    "ChangedPath": {
      "additionalProperties": false,
      "description": "One path a pushed commit changed, from comparing its tree with its parent's: the change, the modes and ids on both sides, and the new blob's size.",
      "examples": [
        {
          "change": "modified",
          "newMode": "100644",
          "newSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "oldMode": "100644",
          "oldSha": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
          "path": "content/pages/about.md",
          "size": 1832,
        },
      ],
      "properties": {
        "change": {
          "description": "What the commit did to the path.",
          "enum": [
            "added",
            "modified",
            "deleted",
          ],
          "enumDescriptions": {
            "added": "The path is new: no entry before (a file replacing a directory is added too).",
            "deleted": "The path is gone (a directory replacing a file deletes the file).",
            "modified": "The path existed and its content or mode changed.",
          },
          "type": "string",
        },
        "newMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileMode",
            },
            {
              "type": "null",
            },
          ],
