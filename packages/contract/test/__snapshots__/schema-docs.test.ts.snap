    "GatewayError.stale_head": {
      "additionalProperties": false,
      "description": "The branch head is not the head the caller expected; nothing was written. Re-read and retry.",
      "examples": [
        {
          "code": "stale_head",
          "details": {
            "actualHead": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "branch": "main",
            "expectedHead": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          },
          "message": "Branch head moved",
        },
      ],
      "properties": {
        "code": {
          "const": "stale_head",
          "description": "The branch head is not the head the caller expected; nothing was written. Re-read and retry.",
          "type": "string",
        },
        "details": {
          "additionalProperties": false,
          "description": "Machine-readable facts about the stale_head error.",
          "properties": {
            "actualHead": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Sha",
                },
                {
                  "type": "null",
                },
              ],
              "description": "The current head; null when the branch does not exist.",
            },
            "branch": {
              "$ref": "#/$defs/BranchName",
              "description": "The branch the write targeted.",
            },
            "expectedHead": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Sha",
                },
                {
                  "type": "null",
                },
              ],
              "description": "The head the caller expected; null when it expected no branch.",
            },
          },
          "required": [
            "branch",
            "expectedHead",
            "actualHead",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "stale_head error",
      "type": "object",
    },
    "GatewayError.storage_unavailable": {
      "additionalProperties": false,
      "description": "The storage backend failed or timed out; the call may be retried with the same input.",
      "examples": [
        {
          "code": "storage_unavailable",
          "details": {
            "retryable": true,
          },
          "message": "Storage backend unavailable",
        },
      ],
      "properties": {
        "code": {
          "const": "storage_unavailable",
          "description": "The storage backend failed or timed out; the call may be retried with the same input.",
          "type": "string",
        },
        "details": {
          "additionalProperties": false,
          "description": "Machine-readable facts about the storage_unavailable error.",
          "properties": {
            "retryable": {
              "const": true,
              "description": "Always true: the same call may succeed later.",
              "type": "boolean",
            },
          },
          "required": [
            "retryable",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "storage_unavailable error",
      "type": "object",
    },
    "GatewayError.unrelated_histories": {
      "additionalProperties": false,
      "description": "syncBranch found no common ancestor between the branches, so there is nothing to merge against.",
      "examples": [
        {
          "code": "unrelated_histories",
          "details": {
            "from": "main",
            "into": "staging",
          },
          "message": "Refusing to merge unrelated histories",
        },
      ],
      "properties": {
        "code": {
          "const": "unrelated_histories",
          "description": "syncBranch found no common ancestor between the branches, so there is nothing to merge against.",
          "type": "string",
        },
        "details": {
          "additionalProperties": false,
          "description": "Machine-readable facts about the unrelated_histories error.",
          "properties": {
            "from": {
              "$ref": "#/$defs/BranchName",
              "description": "The branch being merged in.",
            },
            "into": {
              "$ref": "#/$defs/BranchName",
              "description": "The branch being brought up to date.",
            },
          },
          "required": [
            "from",
            "into",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "unrelated_histories error",
      "type": "object",
    },
    "GatewayErrorBody": {
      "description": "Every error a gateway call can report, discriminated by \`code\`, with a message and typed details. Thrown as a GatewayError whose \`body\` holds it.",
      "examples": [
        {
          "code": "repo_not_found",
          "details": {
            "repo": "acme",
          },
          "message": "Repository not found",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/GatewayError.invalid_input",
        },
        {
          "$ref": "#/$defs/GatewayError.repo_not_found",
        },
        {
          "$ref": "#/$defs/GatewayError.repo_exists",
        },
        {
          "$ref": "#/$defs/GatewayError.ref_not_found",
        },
        {
          "$ref": "#/$defs/GatewayError.path_exists",
        },
        {
          "$ref": "#/$defs/GatewayError.path_not_found",
        },
        {
          "$ref": "#/$defs/GatewayError.path_conflict",
        },
        {
          "$ref": "#/$defs/GatewayError.stale_head",
        },
        {
          "$ref": "#/$defs/GatewayError.not_head_of_source",
        },
        {
          "$ref": "#/$defs/GatewayError.not_fast_forward",
        },
        {
          "$ref": "#/$defs/GatewayError.unrelated_histories",
        },
        {
          "$ref": "#/$defs/GatewayError.storage_unavailable",
        },
      ],
      "title": "Gateway error",
    },
    "GatewayErrorCode": {
      "description": "The machine-readable code of a gateway error.",
      "enum": [
        "invalid_input",
        "repo_not_found",
        "repo_exists",
        "ref_not_found",
        "path_exists",
        "path_not_found",
        "path_conflict",
        "stale_head",
        "not_head_of_source",
        "not_fast_forward",
        "unrelated_histories",
        "storage_unavailable",
      ],
      "enumDescriptions": {
        "invalid_input": "The input failed schema validation.",
        "not_fast_forward": "promote would not be a fast-forward.",
        "not_head_of_source": "promote named a commit that is not the source head.",
        "path_conflict": "A parent of the target path is a file.",
        "path_exists": "A create, upsert or move target already exists.",
        "path_not_found": "An action needed a file that does not exist.",
        "ref_not_found": "A named branch or commit does not exist.",
        "repo_exists": "createRepo named an existing repository.",
        "repo_not_found": "The named repository does not exist.",
        "stale_head": "The branch head is not the one the caller expected.",
        "storage_unavailable": "The storage backend failed; retry later.",
        "unrelated_histories": "syncBranch found no common ancestor.",
      },
      "examples": [
        "stale_head",
      ],
      "title": "Gateway error code",
      "type": "string",
    },
    "HealthResponse": {
      "additionalProperties": false,
      "description": "Body of GET /health. Returned with status 200 whenever the Worker is serving; it does not probe storage backends.",
      "examples": [
        {
          "service": "git-gateway",
          "status": "ok",
        },
      ],
      "properties": {
        "service": {
          "description": "Name of the deployment answering, 1–64 characters; "git-gateway" unless the deployment names itself.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "status": {
          "const": "ok",
          "description": "Always "ok": the gateway Worker is up and routing requests.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "service",
      ],
      "title": "Health response",
      "type": "object",
    },
    "IdempotencyConfig": {
      "additionalProperties": false,
      "description": "How far back commit() looks through the target branch for a commit carrying the same idempotency key. Both bounds apply; the lookup stops at whichever is reached first.",
      "examples": [
        {
          "maxAgeSeconds": 604800,
          "maxCommits": 200,
        },
      ],
      "properties": {
        "maxAgeSeconds": {
          "default": 604800,
          "description": "Commits committed longer ago than this many seconds are not examined; 60 s–30 days, default 7 days (604800).",
          "maximum": 2592000,
          "minimum": 60,
          "type": "integer",
        },
        "maxCommits": {
          "default": 200,
          "description": "Most commits of the branch history examined, newest first; 1–10000, default 200.",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [
        "maxCommits",
        "maxAgeSeconds",
      ],
      "title": "Idempotency window",
      "type": "object",
    },
    "IdempotencyKey": {
      "description": "Caller-chosen key that makes a commit idempotent: 1–128 characters of letters, digits, ".", "_", ":" and "-", starting with a letter or digit. Recorded as a "Gateway-Idempotency-Key:" trailer; a retried commit carrying a key already in the branch's recent history returns that commit instead of writing another.",
      "examples": [
        "cms:publish:2f9c1e",
        "6f1d2c3b-9a8e-4f7d-b6c5-a4e3d2c1b0a9",
      ],
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Idempotency key",
      "type": "string",
    },
    "Identity": {
      "additionalProperties": false,
      "description": "The name and email a commit is attributed to, as an author or a committer.",
      "examples": [
        {
          "email": "ada@example.com",
          "name": "Ada Lovelace",
        },
      ],
      "properties": {
        "email": {
          "description": "Email address, at most 255 characters.",
          "format": "email",
          "maxLength": 255,
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string",
        },
        "name": {
          "description": "Display name, 1–255 characters, without "<", ">", newlines or NUL (git cannot store them).",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^<>\\n\\0]+$",
          "type": "string",
        },
      },
      "required": [
        "name",
        "email",
      ],
      "title": "Identity",
      "type": "object",
    },
    "ListTreeInput": {
      "additionalProperties": false,
      "description": "Input of listTree(): a directory listing at a branch or commit. Fails with ref_not_found if the ref is missing.",
      "examples": [
        {
          "path": "content",
          "recursive": false,
          "ref": "main",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Directory to list. Absent: the repository root.",
        },
        "recursive": {
          "default": false,
          "description": "true lists every entry beneath the directory (directories included); false (default) one level.",
          "type": "boolean",
        },
        "ref": {
          "$ref": "#/$defs/Revision",
          "description": "Branch name or commit id to list at.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to read from.",
        },
      },
      "required": [
        "repo",
        "ref",
        "recursive",
      ],
      "title": "listTree input",
      "type": "object",
    },
    "ListTreeOutput": {
      "anyOf": [
        {
          "$ref": "#/$defs/TreeListing",
        },
        {
          "type": "null",
        },
      ],
      "description": "Output of listTree(): the listing, or null when the path is not a directory at that ref (absent or a file).",
      "examples": [
        null,
      ],
      "title": "listTree output",
    },
    "LogInput": {
      "additionalProperties": false,
      "description": "Input of log(): the history reachable from a branch or commit, newest committer date first (children always before their parents). Fails with ref_not_found if the ref is missing.",
      "examples": [
        {
          "limit": 20,
          "offset": 0,
          "ref": "main",
          "repo": "acme-raw-content",
          "since": "2026-11-01T00:00:00.000Z",
        },
      ],
      "properties": {
        "limit": {
          "default": 50,
          "description": "Most commits returned; 1–500, default 50.",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Commits skipped from the newest before listing; default 0.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "ref": {
          "$ref": "#/$defs/Revision",
          "description": "Branch name or commit id whose history is listed, starting at that commit.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to read from.",
        },
        "since": {
          "$ref": "#/$defs/Timestamp",
          "description": "When given, only commits whose committer date is at or after this time are listed. Absent: no lower bound.",
        },
      },
      "required": [
        "repo",
        "ref",
        "limit",
        "offset",
      ],
      "title": "log input",
      "type": "object",
    },
    "LogOutput": {
      "additionalProperties": false,
      "description": "Output of log(): one page of history.",
      "examples": [
        {
          "commits": [
            {
              "author": {
                "date": "2026-11-20T09:30:00.000Z",
                "email": "ada@example.com",
                "name": "Ada Lovelace",
              },
              "committer": {
                "date": "2026-11-20T09:30:00.000Z",
                "email": "ada@example.com",
                "name": "Ada Lovelace",
              },
              "idempotencyKey": "cms:publish:2f9c1e",
              "message": "Update about page

Gateway-Idempotency-Key: cms:publish:2f9c1e
",
              "parents": [
                "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
              ],
              "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
              "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
            },
          ],
          "hasMore": false,
        },
      ],
      "properties": {
        "commits": {
          "description": "The page of history, newest committer date first; empty when nothing matches.",
          "items": {
            "$ref": "#/$defs/Commit",
          },
          "type": "array",
        },
        "hasMore": {
          "description": "true when further matching commits exist beyond this page.",
          "type": "boolean",
        },
      },
      "required": [
        "commits",
        "hasMore",
      ],
      "title": "log output",
      "type": "object",
    },
    "MintReadTokenInput": {
      "additionalProperties": false,
      "description": "Input of mintReadToken(): a short-lived credential that can clone and fetch one repository through the gateway and nothing else. Fails with repo_not_found.",
      "examples": [
        {
          "repo": "acme-raw-content",
          "ttlSeconds": 900,
        },
      ],
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository the token may read.",
        },
        "ttlSeconds": {
          "default": 3600,
          "description": "Lifetime of the token in seconds; 60–86400, default 3600.",
          "maximum": 86400,
          "minimum": 60,
          "type": "integer",
        },
      },
      "required": [
        "repo",
        "ttlSeconds",
      ],
      "title": "mintReadToken input",
      "type": "object",
    },
    "MintReadTokenOutput": {
      "additionalProperties": false,
      "description": "Output of mintReadToken(): a read-only credential for one repository and where to use it.",
      "examples": [
        {
          "expiresAt": "2026-11-20T09:30:00.000Z",
          "remoteUrl": "https://git.example.com/acme-raw-content.git",
          "token": "ggr_0123456789abcdef0123456789abcdef",
        },
      ],
      "properties": {
        "expiresAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the token stops working.",
        },
        "remoteUrl": {
          "description": "Clone URL the token is good for: <publicBaseUrl>/<repo>.git.",
          "format": "uri",
          "type": "string",
        },
        "token": {
          "description": "The credential: send it as the HTTP Basic password (any username) or as a Bearer token. Secret.",
          "maxLength": 4096,
          "minLength": 16,
          "type": "string",
        },
      },
      "required": [
        "token",
        "expiresAt",
        "remoteUrl",
      ],
      "title": "mintReadToken output",
      "type": "object",
    },
    "MoveAction": {
      "additionalProperties": false,
      "description": "Moves a file, keeping its executable bit and, unless \`content\` is given, its content. Fails with path_not_found if \`previousPath\` is not a file, path_exists if \`path\` exists, and path_conflict if a parent of \`path\` is a file.",
      "examples": [
        {
          "action": "move",
          "encoding": "text",
          "path": "content/new.md",
          "previousPath": "content/old.md",
        },
      ],
      "properties": {
        "action": {
          "const": "move",
          "description": "Move a file from \`previousPath\` to \`path\`.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "New content for the moved file, encoded as \`encoding\` says. Absent: the content is kept.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Destination path; it must not exist and no parent of it may be a file.",
        },
        "previousPath": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the existing file to move.",
        },
      },
      "required": [
        "action",
        "path",
        "previousPath",
        "encoding",
      ],
      "title": "Move action",
      "type": "object",
    },
    "PromoteInput": {
      "additionalProperties": false,
      "description": "Input of promote(): fast-forward \`into\` to \`sha\`, only if \`sha\` is the head of \`from\` and contains the head of \`into\`. Never merges, never forces. Refusals: ref_not_found (from missing), not_head_of_source, not_fast_forward.",
      "examples": [
        {
          "from": "staging",
          "into": "main",
          "repo": "acme-raw-content",
          "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
        },
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch whose head is promoted, e.g. staging.",
        },
        "into": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch fast-forwarded, e.g. main. Created at \`sha\` if it does not exist.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository holding both branches.",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "The commit to promote; must be the current head of \`from\`.",
        },
      },
      "required": [
        "repo",
        "from",
        "into",
        "sha",
      ],
      "title": "promote input",
      "type": "object",
    },
    "PromoteOutput": {
      "description": "Output of promote(), discriminated by \`status\`. Refusals are thrown as GatewayErrors.",
      "examples": [
        {
          "head": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "status": "up_to_date",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/PromotePromoted",
        },
        {
          "$ref": "#/$defs/PromoteUpToDate",
        },
      ],
      "title": "promote output",
    },
    "PromotePromoted": {
      "additionalProperties": false,
      "description": "promote() fast-forwarded \`into\` to \`sha\`, or created it there.",
      "examples": [
        {
          "refUpdate": {
            "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            "ref": "refs/heads/main",
          },
          "status": "promoted",
        },
      ],
      "properties": {
        "refUpdate": {
          "$ref": "#/$defs/RefUpdate",
          "description": "How \`into\` moved; oldSha is all zeros when promote created it.",
        },
        "status": {
          "const": "promoted",
          "description": "\`into\` now points at \`sha\`.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "refUpdate",
      ],
      "title": "promote: promoted",
      "type": "object",
    },
    "PromoteUpToDate": {
      "additionalProperties": false,
      "description": "promote() found \`into\` already at \`sha\`.",
      "examples": [
        {
          "head": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "status": "up_to_date",
        },
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/Sha",
          "description": "The head of \`into\`, equal to \`sha\`.",
        },
        "status": {
          "const": "up_to_date",
          "description": "\`into\` already points at \`sha\`; nothing changed.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "head",
      ],
      "title": "promote: up to date",
      "type": "object",
    },
    "ReadContent": {
      "description": "File content returned by a read, interpreted according to the accompanying encoding: UTF-8 text, or base64 of the raw bytes. Not length-capped: base64 output is 4/3 the size of the bytes and files can arrive over git push at any size, so a read returns whatever the repository holds. An empty string is an empty file.",
      "examples": [
        "# Hello
",
        "iVBORw0KGgo=",
      ],
      "title": "Read content",
      "type": "string",
    },
    "ReadFileInput": {
      "additionalProperties": false,
      "description": "Input of readFile(): one file at a branch or commit. Fails with ref_not_found if the ref is missing.",
      "examples": [
        {
          "encoding": "text",
          "path": "content/about.md",
          "ref": "main",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "Preferred encoding of the returned content. "text" (default) returns text when the bytes are valid UTF-8 and falls back to base64 otherwise; "base64" always returns base64.",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the file to read.",
        },
        "ref": {
          "$ref": "#/$defs/Revision",
          "description": "Branch name or commit id to read the file at.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to read from.",
        },
      },
      "required": [
        "repo",
        "ref",
        "path",
        "encoding",
      ],
      "title": "readFile input",
      "type": "object",
    },
    "ReadFileOutput": {
      "anyOf": [
        {
          "$ref": "#/$defs/FileRead",
        },
        {
          "type": "null",
        },
      ],
      "description": "Output of readFile(): the file, or null when the path is not a file at that ref (absent or a directory).",
      "examples": [
        null,
      ],
      "title": "readFile output",
    },
    "RefUpdate": {
      "additionalProperties": false,
      "description": "One ref moved by a write, in receive-pack command form: the ref, the id it named before and the id it names after. Creation and deletion use the all-zero id on the missing side.",
      "examples": [
        {
          "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "ref": "refs/heads/main",
        },
      ],
      "properties": {
        "newSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the ref points at after the update; the all-zero id when the update deleted the ref.",
        },
        "oldSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the ref pointed at before the update; the all-zero id when the update created the ref.",
        },
        "ref": {
          "$ref": "#/$defs/FullRefName",
          "description": "The ref that moved, fully qualified (refs/heads/<branch>).",
        },
      },
      "required": [
        "ref",
        "oldSha",
        "newSha",
      ],
      "title": "Ref update",
      "type": "object",
    },
    "RepoInfo": {
      "additionalProperties": false,
      "description": "A repository behind the gateway.",
      "examples": [
        {
          "createdAt": "2026-11-20T09:30:00.000Z",
          "defaultBranch": "main",
          "name": "acme-raw-content",
          "remoteUrl": "https://git.example.com/acme-raw-content.git",
        },
      ],
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the repository was created.",
        },
        "defaultBranch": {
          "$ref": "#/$defs/BranchName",
          "description": "The branch HEAD names.",
        },
        "name": {
          "$ref": "#/$defs/RepoName",
          "description": "The repository name.",
        },
        "remoteUrl": {
          "description": "Clone URL of the repository on the gateway: <publicBaseUrl>/<name>.git.",
          "format": "uri",
          "type": "string",
        },
      },
      "required": [
        "name",
        "defaultBranch",
        "createdAt",
        "remoteUrl",
      ],
      "title": "Repository",
      "type": "object",
    },
    "RepoName": {
      "description": "Name of a repository behind the gateway: 1–100 characters of letters, digits, ".", "_" and "-", starting with a letter or digit and not ending in ".git". Served at /<name>.git.",
      "examples": [
        "acme-raw-content",
        "site.example",
      ],
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Repository name",
      "type": "string",
    },
    "ResolveRefInput": {
      "additionalProperties": false,
      "description": "Input of resolveRef(): resolve a branch to its head, or confirm a commit id exists.",
      "examples": [
        {
          "ref": "main",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/Revision",
          "description": "Branch name to resolve, or commit id to check.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to look in.",
        },
      },
      "required": [
        "repo",
        "ref",
      ],
      "title": "resolveRef input",
      "type": "object",
    },
    "ResolveRefOutput": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "sha": {
              "$ref": "#/$defs/Sha",
              "description": "Id of the commit the ref names.",
            },
          },
          "required": [
            "sha",
          ],
          "type": "object",
        },
        {
          "type": "null",
        },
      ],
      "description": "Output of resolveRef(): the commit id the ref names, or null when the branch or commit does not exist.",
      "examples": [
        {
          "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
        },
        null,
      ],
      "title": "resolveRef output",
    },
    "Revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha",
          "description": "A commit id. Any 40-character lowercase hex string is read as a commit id, never a branch.",
        },
        {
          "$ref": "#/$defs/BranchName",
          "description": "A branch name, resolved to the branch head at the time of the call.",
        },
      ],
      "description": "What a read is made against: a 40-character lowercase hex commit id, or a short branch name resolved to its current head.",
      "examples": [
        "main",
        "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
      ],
      "title": "Revision",
    },
    "Sha": {
      "description": "A git object id: 40-character lowercase hex SHA-1 naming a commit, tree or blob. Never abbreviated.",
      "examples": [
        "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
      ],
      "pattern": "^[0-9a-f]{40}$",
      "title": "Object id",
      "type": "string",
    },
    "Signature": {
      "additionalProperties": false,
      "description": "An identity together with the time it authored or committed a commit, as stored in the commit.",
      "examples": [
        {
          "date": "2026-11-20T09:30:00.000Z",
          "email": "ada@example.com",
          "name": "Ada Lovelace",
        },
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/Timestamp",
          "description": "When this person authored or committed the change, as an ISO 8601 UTC timestamp.",
        },
        "email": {
          "description": "Email address, at most 255 characters.",
          "format": "email",
          "maxLength": 255,
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string",
        },
        "name": {
          "description": "Display name, 1–255 characters, without "<", ">", newlines or NUL (git cannot store them).",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^<>\\n\\0]+$",
          "type": "string",
        },
      },
      "required": [
        "name",
        "email",
        "date",
      ],
      "title": "Signature",
      "type": "object",
    },
    "SyncBranchInput": {
      "additionalProperties": false,
      "description": "Input of syncBranch(): bring \`into\` up to date with \`from\` without rewriting \`into\`. Fails with ref_not_found if either branch is missing and unrelated_histories if they share no ancestor.",
      "examples": [
        {
          "from": "main",
          "into": "staging",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "author": {
          "$ref": "#/$defs/Identity",
          "description": "Author and committer of a merge commit, if one is needed. Absent: the configured service identity.",
        },
        "from": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch whose commits are brought into \`into\`.",
        },
        "into": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch brought up to date; never rewritten, only fast-forwarded or merged into.",
        },
        "message": {
          "description": "Message of a merge commit, if one is needed. Absent: "Merge branch '<from>' into <into>".",
          "maxLength": 65536,
          "minLength": 1,
          "type": "string",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository holding both branches.",
        },
      },
      "required": [
        "repo",
        "from",
        "into",
      ],
      "title": "syncBranch input",
      "type": "object",
    },
    "SyncBranchOutput": {
      "description": "Output of syncBranch(), discriminated by \`status\`.",
      "examples": [
        {
          "head": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "status": "up_to_date",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/SyncUpToDate",
        },
        {
          "$ref": "#/$defs/SyncFastForward",
        },
        {
          "$ref": "#/$defs/SyncMerged",
        },
        {
          "$ref": "#/$defs/SyncConflict",
        },
      ],
      "title": "syncBranch output",
    },
    "SyncConflict": {
      "additionalProperties": false,
      "description": "syncBranch() could not merge: the listed paths conflict. \`into\` is unchanged.",
      "examples": [
        {
          "base": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
          "fromHead": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "intoHead": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "paths": [
            "content/about.md",
          ],
          "status": "conflict",
        },
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/Sha",
          "description": "The merge base used.",
        },
        "fromHead": {
          "$ref": "#/$defs/Sha",
          "description": "The head of \`from\` merged.",
        },
        "intoHead": {
          "$ref": "#/$defs/Sha",
          "description": "The head of \`into\`, unchanged.",
        },
        "paths": {
          "description": "Every conflicting path, sorted in byte order: changed differently on both sides, or a file on one side where the other has a directory.",
          "items": {
            "$ref": "#/$defs/FilePath",
            "description": "A conflicting path.",
          },
          "minItems": 1,
          "type": "array",
        },
        "status": {
          "const": "conflict",
          "description": "Some paths changed differently on both sides; nothing was written.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "paths",
        "base",
        "fromHead",
        "intoHead",
      ],
      "title": "syncBranch: conflict",
      "type": "object",
    },
    "SyncFastForward": {
      "additionalProperties": false,
      "description": "syncBranch() fast-forwarded \`into\` to the head of \`from\` with a ref update naming the old head.",
      "examples": [
        {
          "refUpdate": {
            "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            "ref": "refs/heads/staging",
          },
          "status": "fast_forward",
        },
      ],
      "properties": {
        "refUpdate": {
          "$ref": "#/$defs/RefUpdate",
          "description": "How \`into\` moved.",
        },
        "status": {
          "const": "fast_forward",
          "description": "\`into\` had no commits of its own and now points at the head of \`from\`.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "refUpdate",
      ],
      "title": "syncBranch: fast-forward",
      "type": "object",
    },
    "SyncMerged": {
      "additionalProperties": false,
      "description": "syncBranch() merged file by file against the merge base: a path changed on one side takes that side.",
      "examples": [
        {
          "commit": {
            "author": {
              "date": "2026-11-20T09:30:00.000Z",
              "email": "ada@example.com",
              "name": "Ada Lovelace",
            },
            "committer": {
              "date": "2026-11-20T09:30:00.000Z",
              "email": "ada@example.com",
              "name": "Ada Lovelace",
            },
            "idempotencyKey": "cms:publish:2f9c1e",
            "message": "Update about page

Gateway-Idempotency-Key: cms:publish:2f9c1e
",
            "parents": [
              "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            ],
            "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
          },
          "refUpdate": {
            "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            "ref": "refs/heads/staging",
          },
          "status": "merged",
        },
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/Commit",
          "description": "The merge commit; its parents are the old head of \`into\`, then the head of \`from\`.",
        },
        "refUpdate": {
          "$ref": "#/$defs/RefUpdate",
          "description": "How \`into\` moved.",
        },
        "status": {
          "const": "merged",
          "description": "Both branches had commits; a file-level merge commit was written to \`into\`.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "commit",
        "refUpdate",
      ],
      "title": "syncBranch: merged",
      "type": "object",
    },
    "SyncRule": {
      "additionalProperties": false,
      "description": "An onPush rule: after any push to \`from\`, run syncBranch({ from, into }) as a SyncBranchWorkflow with retries.",
      "examples": [
        {
          "from": "main",
          "into": "staging",
        },
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/BranchName",
          "description": "The branch whose pushes trigger the sync.",
        },
        "into": {
          "$ref": "#/$defs/BranchName",
          "description": "The branch brought up to date with \`from\` by syncBranch.",
        },
      },
      "required": [
        "from",
        "into",
      ],
      "title": "Sync rule",
      "type": "object",
    },
    "SyncUpToDate": {
      "additionalProperties": false,
      "description": "syncBranch() found that \`into\` already contains the head of \`from\`.",
      "examples": [
        {
          "head": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "status": "up_to_date",
        },
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/Sha",
          "description": "The head of \`into\`, unchanged.",
        },
        "status": {
          "const": "up_to_date",
          "description": "\`into\` already contains the head of \`from\`; nothing changed.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "head",
      ],
      "title": "syncBranch: up to date",
      "type": "object",
    },
    "Timestamp": {
      "description": "A point in time as an ISO 8601 UTC timestamp ending in "Z", with optional fractional seconds (e.g. 2026-11-20T09:30:00.000Z).",
      "examples": [
        "2026-11-20T09:30:00.000Z",
      ],
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "title": "Timestamp",
      "type": "string",
    },
    "TreeEntry": {
      "additionalProperties": false,
      "description": "One entry of a directory listing: a file, directory, symbolic link or submodule.",
      "examples": [
        {
          "mode": "100644",
          "name": "about.md",
          "path": "content/about.md",
          "sha": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
          "type": "blob",
        },
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/FileMode",
        },
        "name": {
          "description": "Last segment of the path: 1–255 characters without "/" or NUL.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/\\0]+$",
          "type": "string",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Full path of the entry from the repository root.",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the blob, tree or submodule commit the entry names.",
        },
        "type": {
          "$ref": "#/$defs/TreeEntryType",
        },
      },
      "required": [
        "path",
        "name",
        "type",
        "mode",
        "sha",
      ],
      "title": "Tree entry",
      "type": "object",
    },
    "TreeEntryType": {
      "description": "The kind of object a tree entry names.",
      "enum": [
        "blob",
        "tree",
        "commit",
      ],
      "enumDescriptions": {
        "blob": "A file or symbolic link (modes 100644, 100755, 120000).",
        "commit": "A submodule commit in another repository (mode 160000).",
        "tree": "A directory (mode 040000).",
      },
      "examples": [
        "blob",
        "tree",
      ],
      "title": "Tree entry type",
      "type": "string",
    },
    "TreeListing": {
      "additionalProperties": false,
      "description": "A directory listing at a commit.",
      "examples": [
        {
          "commit": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "entries": [
            {
              "mode": "100644",
              "name": "about.md",
              "path": "content/about.md",
              "sha": "f2a5b0a7d1d3d1f1c1c3e7e5d2b9b7e1a3c5d7e9",
              "type": "blob",
            },
          ],
          "path": "content",
        },
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the commit listed (the ref resolved).",
        },
        "entries": {
          "description": "Entries sorted by full path in byte order; empty for a repository root with no files.",
          "items": {
            "$ref": "#/$defs/TreeEntry",
          },
          "type": "array",
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilePath",
            },
            {
              "type": "null",
            },
          ],
          "description": "The directory listed; null for the repository root.",
        },
      },
      "required": [
        "commit",
        "path",
        "entries",
      ],
      "title": "Tree listing",
      "type": "object",
    },
    "UpdateAction": {
      "additionalProperties": false,
      "description": "Replaces the content of an existing file, keeping its executable bit. Fails with path_not_found if the path is not a file.",
      "examples": [
        {
          "action": "update",
          "content": "# About us
",
          "encoding": "text",
          "path": "content/about.md",
        },
      ],
      "properties": {
        "action": {
          "const": "update",
          "description": "Replace an existing file. Fails with path_not_found if it is absent.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "New content of the file, encoded as \`encoding\` says.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the existing file to replace.",
        },
      },
      "required": [
        "action",
        "path",
        "content",
        "encoding",
      ],
      "title": "Update action",
      "type": "object",
    },
    "UpsertAction": {
      "additionalProperties": false,
      "description": "Creates the file, or replaces it (keeping its executable bit) if it exists. Fails with path_exists if the path is a directory and path_conflict if a parent is a file. Not part of the GitLab Commits API.",
      "examples": [
        {
          "action": "upsert",
          "content": "iVBORw0KGgo=",
          "encoding": "base64",
          "path": "assets/logo.png",
        },
      ],
      "properties": {
        "action": {
          "const": "upsert",
          "description": "Create the file, or replace it if it exists.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "Content of the file, encoded as \`encoding\` says.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the file to create or replace.",
        },
      },
      "required": [
        "action",
        "path",
        "content",
        "encoding",
      ],
      "title": "Upsert action",
      "type": "object",
    },
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
}
