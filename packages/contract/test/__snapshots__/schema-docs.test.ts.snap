    "GatewayErrorBody": {
      "description": "Every error a gateway call can report, discriminated by \`code\`, with a message and typed details. Thrown as a GatewayError whose \`body\` holds it.",
      "examples": [
        {
          "code": "repo_not_found",
          "details": {
            "repo": "acme",
          },
          "message": "Repository not found",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/GatewayError.invalid_input",
        },
        {
          "$ref": "#/$defs/GatewayError.repo_not_found",
        },
        {
          "$ref": "#/$defs/GatewayError.repo_exists",
        },
        {
          "$ref": "#/$defs/GatewayError.ref_not_found",
        },
        {
          "$ref": "#/$defs/GatewayError.path_exists",
        },
        {
          "$ref": "#/$defs/GatewayError.path_not_found",
        },
        {
          "$ref": "#/$defs/GatewayError.path_conflict",
        },
        {
          "$ref": "#/$defs/GatewayError.stale_head",
        },
        {
          "$ref": "#/$defs/GatewayError.not_head_of_source",
        },
        {
          "$ref": "#/$defs/GatewayError.not_fast_forward",
        },
        {
          "$ref": "#/$defs/GatewayError.unrelated_histories",
        },
        {
          "$ref": "#/$defs/GatewayError.storage_unavailable",
        },
      ],
      "title": "Gateway error",
    },
    "GatewayErrorCode": {
      "description": "The machine-readable code of a gateway error.",
      "enum": [
        "invalid_input",
        "repo_not_found",
        "repo_exists",
        "ref_not_found",
        "path_exists",
        "path_not_found",
        "path_conflict",
        "stale_head",
        "not_head_of_source",
        "not_fast_forward",
        "unrelated_histories",
        "storage_unavailable",
      ],
      "enumDescriptions": {
        "invalid_input": "The input failed schema validation.",
        "not_fast_forward": "promote would not be a fast-forward.",
        "not_head_of_source": "promote named a commit that is not the source head.",
        "path_conflict": "A parent of the target path is a file.",
        "path_exists": "A create, upsert or move target already exists.",
        "path_not_found": "An action needed a file that does not exist.",
        "ref_not_found": "A named branch or commit does not exist.",
        "repo_exists": "createRepo named an existing repository.",
        "repo_not_found": "The named repository does not exist.",
        "stale_head": "The branch head is not the one the caller expected.",
        "storage_unavailable": "The storage backend failed; retry later.",
        "unrelated_histories": "syncBranch found no common ancestor.",
      },
      "examples": [
        "stale_head",
      ],
      "title": "Gateway error code",
      "type": "string",
    },
    "GitAccess": {
      "description": "What a git remote from StorageBackend.gitRemote() is allowed to do on the storage host.",
      "enum": [
        "read",
        "write",
      ],
      "enumDescriptions": {
        "read": "Fetch and clone only (git-upload-pack).",
        "write": "Fetch, clone and push (git-upload-pack and git-receive-pack).",
      },
      "examples": [
        "read",
        "write",
      ],
      "title": "Git access",
      "type": "string",
    },
    "GitOperation": {
      "description": "What a git client asks to do to a repository through the gateway; Authorizer.authorize() decides each per principal and repository.",
      "enum": [
        "read",
        "write",
      ],
      "enumDescriptions": {
        "read": "Clone or fetch: GET info/refs?service=git-upload-pack and POST git-upload-pack.",
        "write": "Push: GET info/refs?service=git-receive-pack and POST git-receive-pack.",
      },
      "examples": [
        "read",
        "write",
      ],
      "title": "Git operation",
      "type": "string",
    },
    "GitRemote": {
      "additionalProperties": false,
      "description": "A storage-host git remote minted for one use: the smart-HTTP URL plus the headers that authorize it. The gateway proxies to it; the credential never reaches a git client.",
      "examples": [
        {
          "expiresAt": "2026-11-20T09:35:00.000Z",
          "headers": {
            "Authorization": "Bearer art_v2_example",
          },
          "url": "https://artifacts.example.com/git/default/acme-raw-content.git",
        },
      ],
      "properties": {
        "expiresAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "When the credential in \`headers\` stops working, as an ISO 8601 UTC timestamp; null when the host does not say (for example a long-lived access token).",
        },
        "headers": {
          "additionalProperties": {
            "description": "HTTP header value. Secret when it carries a credential.",
            "type": "string",
          },
          "description": "HTTP headers every request to the remote must carry, typically the short-lived credential as "Authorization". Secret: never log it or hand it to a git client.",
          "propertyNames": {
            "description": "HTTP header name, e.g. "Authorization".",
            "minLength": 1,
            "type": "string",
          },
          "type": "object",
        },
        "url": {
          "description": "The repository's smart-HTTP base URL on the storage host, ending in ".git"; append "/info/refs?service=…", "/git-upload-pack" or "/git-receive-pack". Never holds a credential.",
          "format": "uri",
          "type": "string",
        },
      },
      "required": [
        "url",
        "headers",
        "expiresAt",
      ],
      "title": "Git remote",
      "type": "object",
    },
    "HealthResponse": {
      "additionalProperties": false,
      "description": "Body of GET /health. Returned with status 200 whenever the Worker is serving; it does not probe storage backends.",
      "examples": [
        {
          "service": "git-gateway",
          "status": "ok",
        },
      ],
      "properties": {
        "service": {
          "description": "Name of the deployment answering, 1–64 characters; "git-gateway" unless the deployment names itself.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "status": {
          "const": "ok",
          "description": "Always "ok": the gateway Worker is up and routing requests.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "service",
      ],
      "title": "Health response",
      "type": "object",
    },
    "IdempotencyConfig": {
      "additionalProperties": false,
      "description": "How far back commit() looks through the target branch for a commit carrying the same idempotency key. Both bounds apply; the lookup stops at whichever is reached first.",
      "examples": [
        {
          "maxAgeSeconds": 604800,
          "maxCommits": 200,
        },
      ],
      "properties": {
        "maxAgeSeconds": {
          "default": 604800,
          "description": "Commits committed longer ago than this many seconds are not examined; 60 s–30 days, default 7 days (604800).",
          "maximum": 2592000,
          "minimum": 60,
          "type": "integer",
        },
        "maxCommits": {
          "default": 200,
          "description": "Most commits of the branch history examined, newest first; 1–10000, default 200.",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [
        "maxCommits",
        "maxAgeSeconds",
      ],
      "title": "Idempotency window",
      "type": "object",
    },
    "IdempotencyKey": {
      "description": "Caller-chosen key that makes a commit idempotent: 1–128 characters of letters, digits, ".", "_", ":" and "-", starting with a letter or digit. Recorded as a "Gateway-Idempotency-Key:" trailer; a retried commit carrying a key already in the branch's recent history returns that commit instead of writing another.",
      "examples": [
        "cms:publish:2f9c1e",
        "6f1d2c3b-9a8e-4f7d-b6c5-a4e3d2c1b0a9",
      ],
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Idempotency key",
      "type": "string",
    },
    "Identity": {
      "additionalProperties": false,
      "description": "The name and email a commit is attributed to, as an author or a committer.",
      "examples": [
        {
          "email": "ada@example.com",
          "name": "Ada Lovelace",
        },
      ],
      "properties": {
        "email": {
          "description": "Email address, at most 255 characters.",
          "format": "email",
          "maxLength": 255,
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string",
        },
        "name": {
          "description": "Display name, 1–255 characters, without "<", ">", newlines or NUL (git cannot store them).",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^<>\\n\\0]+$",
          "type": "string",
        },
      },
      "required": [
        "name",
        "email",
      ],
      "title": "Identity",
      "type": "object",
    },
    "ListTreeInput": {
      "additionalProperties": false,
      "description": "Input of listTree(): a directory listing at a branch or commit. Fails with ref_not_found if the ref is missing.",
      "examples": [
        {
          "path": "content",
          "recursive": false,
          "ref": "main",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Directory to list. Absent: the repository root.",
        },
        "recursive": {
          "default": false,
          "description": "true lists every entry beneath the directory (directories included); false (default) one level.",
          "type": "boolean",
        },
        "ref": {
          "$ref": "#/$defs/Revision",
          "description": "Branch name or commit id to list at.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to read from.",
        },
      },
      "required": [
        "repo",
        "ref",
        "recursive",
      ],
      "title": "listTree input",
      "type": "object",
    },
    "ListTreeOutput": {
      "anyOf": [
        {
          "$ref": "#/$defs/TreeListing",
        },
        {
          "type": "null",
        },
      ],
      "description": "Output of listTree(): the listing, or null when the path is not a directory at that ref (absent or a file).",
      "examples": [
        null,
      ],
      "title": "listTree output",
    },
    "LogInput": {
      "additionalProperties": false,
      "description": "Input of log(): the history reachable from a branch or commit, newest committer date first (children always before their parents). Fails with ref_not_found if the ref is missing.",
      "examples": [
        {
          "limit": 20,
          "offset": 0,
          "ref": "main",
          "repo": "acme-raw-content",
          "since": "2026-11-01T00:00:00.000Z",
        },
      ],
      "properties": {
        "limit": {
          "default": 50,
          "description": "Most commits returned; 1–500, default 50.",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Commits skipped from the newest before listing; default 0.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "ref": {
          "$ref": "#/$defs/Revision",
          "description": "Branch name or commit id whose history is listed, starting at that commit.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to read from.",
        },
        "since": {
          "$ref": "#/$defs/Timestamp",
          "description": "When given, only commits whose committer date is at or after this time are listed. Absent: no lower bound.",
        },
      },
      "required": [
        "repo",
        "ref",
        "limit",
        "offset",
      ],
      "title": "log input",
      "type": "object",
    },
    "LogOutput": {
      "additionalProperties": false,
      "description": "Output of log(): one page of history.",
      "examples": [
        {
          "commits": [
            {
              "author": {
                "date": "2026-11-20T09:30:00.000Z",
                "email": "ada@example.com",
                "name": "Ada Lovelace",
              },
              "committer": {
                "date": "2026-11-20T09:30:00.000Z",
                "email": "ada@example.com",
                "name": "Ada Lovelace",
              },
              "idempotencyKey": "cms:publish:2f9c1e",
              "message": "Update about page

Gateway-Idempotency-Key: cms:publish:2f9c1e
",
              "parents": [
                "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
              ],
              "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
              "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
            },
          ],
          "hasMore": false,
        },
      ],
      "properties": {
        "commits": {
          "description": "The page of history, newest committer date first; empty when nothing matches.",
          "items": {
            "$ref": "#/$defs/Commit",
          },
          "type": "array",
        },
        "hasMore": {
          "description": "true when further matching commits exist beyond this page.",
          "type": "boolean",
        },
      },
      "required": [
        "commits",
        "hasMore",
      ],
      "title": "log output",
      "type": "object",
    },
    "MintReadTokenInput": {
      "additionalProperties": false,
      "description": "Input of mintReadToken(): a short-lived credential that can clone and fetch one repository through the gateway and nothing else. Fails with repo_not_found.",
      "examples": [
        {
          "repo": "acme-raw-content",
          "ttlSeconds": 900,
        },
      ],
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository the token may read.",
        },
        "ttlSeconds": {
          "default": 3600,
          "description": "Lifetime of the token in seconds; 60–86400, default 3600.",
          "maximum": 86400,
          "minimum": 60,
          "type": "integer",
        },
      },
      "required": [
        "repo",
        "ttlSeconds",
      ],
      "title": "mintReadToken input",
      "type": "object",
    },
    "MintReadTokenOutput": {
      "additionalProperties": false,
      "description": "Output of mintReadToken(): a read-only credential for one repository and where to use it.",
      "examples": [
        {
          "expiresAt": "2026-11-20T09:30:00.000Z",
          "remoteUrl": "https://git.example.com/acme-raw-content.git",
          "token": "ggr_0123456789abcdef0123456789abcdef",
        },
      ],
      "properties": {
        "expiresAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the token stops working.",
        },
        "remoteUrl": {
          "description": "Clone URL the token is good for: <publicBaseUrl>/<repo>.git.",
          "format": "uri",
          "type": "string",
        },
        "token": {
          "description": "The credential: send it as the HTTP Basic password (any username) or as a Bearer token. Secret.",
          "maxLength": 4096,
          "minLength": 16,
          "type": "string",
        },
      },
      "required": [
        "token",
        "expiresAt",
        "remoteUrl",
      ],
      "title": "mintReadToken output",
      "type": "object",
    },
    "MoveAction": {
      "additionalProperties": false,
      "description": "Moves a file, keeping its executable bit and, unless \`content\` is given, its content. Fails with path_not_found if \`previousPath\` is not a file, path_exists if \`path\` exists, and path_conflict if a parent of \`path\` is a file.",
      "examples": [
        {
          "action": "move",
          "encoding": "text",
          "path": "content/new.md",
          "previousPath": "content/old.md",
        },
      ],
      "properties": {
        "action": {
          "const": "move",
          "description": "Move a file from \`previousPath\` to \`path\`.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "New content for the moved file, encoded as \`encoding\` says. Absent: the content is kept.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Destination path; it must not exist and no parent of it may be a file.",
        },
        "previousPath": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the existing file to move.",
        },
      },
      "required": [
        "action",
        "path",
        "previousPath",
        "encoding",
      ],
      "title": "Move action",
      "type": "object",
    },
    "PolicyResult": {
      "additionalProperties": false,
      "description": "The branch policy verdict on every ref update of one push. The gateway forwards the push only when all of them are allowed (fast-forward-only ones after their ancestry is proven); otherwise nothing is written and git reports each refused ref with its reason.",
      "examples": [
        {
          "refs": [
            {
              "decision": "fast-forward-only",
              "reason": "force pushes to main are not allowed",
              "ref": "refs/heads/main",
            },
            {
              "decision": "deny",
              "reason": "tags are created by the release pipeline",
              "ref": "refs/tags/v1.0.0",
            },
          ],
        },
      ],
      "properties": {
        "refs": {
          "description": "One decision per update the policy was given, for the same refs, each ref named at most once (a result naming a ref twice is refused, so the gateway never has to pick between conflicting decisions). A push is forwarded only when every update is allowed; an update without a decision is refused.",
          "items": {
            "$ref": "#/$defs/RefDecision",
          },
          "maxItems": 10000,
          "type": "array",
        },
      },
      "required": [
        "refs",
      ],
      "title": "Policy result",
      "type": "object",
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Who a smart-HTTP request acts for, as returned by an Authenticator. Authorizers, branch policy, the audit hook and the decision cache all key on it; it never carries the credential itself.",
      "examples": [
        {
          "email": "ada@example.com",
          "expiresAt": "2026-11-20T10:30:00.000Z",
          "name": "Ada Lovelace",
          "roles": [
            "maintainer",
          ],
          "subject": "user:42",
        },
      ],
      "properties": {
        "email": {
          "anyOf": [
            {
              "format": "email",
              "maxLength": 255,
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "Email address, at most 255 characters; null (the default) when unknown.",
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "When the credential that established this principal stops being valid, as an ISO 8601 UTC timestamp; cached decisions never outlive it. Null (the default) when the credential does not expire or the authenticator does not say.",
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^\\n\\0]+$",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "Display name for logs and audit, 1–255 characters without newline or NUL; null (the default) when the authenticator does not know one.",
        },
        "roles": {
          "default": [],
          "description": "Roles or groups granted to the caller, at most 100; default none.",
          "items": {
            "$ref": "#/$defs/Role",
          },
          "maxItems": 100,
          "type": "array",
        },
        "subject": {
          "description": "Stable identifier of the caller in the deployment (e.g. the JWT "sub" claim or a user id): 1–255 characters without newline or NUL. Used for policy matching, audit and caching; never a credential.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\n\\0]+$",
          "type": "string",
        },
      },
      "required": [
        "subject",
        "name",
        "email",
        "roles",
        "expiresAt",
      ],
      "title": "Principal",
      "type": "object",
    },
    "PrincipalSelector": {
      "additionalProperties": false,
      "description": "Selects principals by subject or role: a principal matches when its subject is listed or it holds any listed role. With both lists empty it matches nobody.",
      "examples": [
        {
          "roles": [
            "maintainer",
          ],
          "subjects": [
            "user:42",
          ],
        },
      ],
      "properties": {
        "roles": {
          "default": [],
          "description": "Principals holding any of these roles; at most 100, default none.",
          "items": {
            "$ref": "#/$defs/Role",
          },
          "maxItems": 100,
          "type": "array",
        },
        "subjects": {
          "default": [],
          "description": "Principals named by subject; at most 1000, default none.",
          "items": {
            "description": "A principal subject, compared exactly with Principal.subject.",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[^\\n\\0]+$",
            "type": "string",
          },
          "maxItems": 1000,
          "type": "array",
        },
      },
      "required": [
        "subjects",
        "roles",
      ],
      "title": "Principal selector",
      "type": "object",
    },
    "PromoteInput": {
      "additionalProperties": false,
      "description": "Input of promote(): fast-forward \`into\` to \`sha\`, only if \`sha\` is the head of \`from\` and contains the head of \`into\`. Never merges, never forces. Refusals: ref_not_found (from missing), not_head_of_source, not_fast_forward.",
      "examples": [
        {
          "from": "staging",
          "into": "main",
          "repo": "acme-raw-content",
          "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
        },
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch whose head is promoted, e.g. staging.",
        },
        "into": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch fast-forwarded, e.g. main. Created at \`sha\` if it does not exist.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository holding both branches.",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "The commit to promote; must be the current head of \`from\`.",
        },
      },
      "required": [
        "repo",
        "from",
        "into",
        "sha",
      ],
      "title": "promote input",
      "type": "object",
    },
    "PromoteOutput": {
      "description": "Output of promote(), discriminated by \`status\`. Refusals are thrown as GatewayErrors.",
      "examples": [
        {
          "head": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "status": "up_to_date",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/PromotePromoted",
        },
        {
          "$ref": "#/$defs/PromoteUpToDate",
        },
      ],
      "title": "promote output",
    },
    "PromotePromoted": {
      "additionalProperties": false,
      "description": "promote() fast-forwarded \`into\` to \`sha\`, or created it there.",
      "examples": [
        {
          "refUpdate": {
            "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            "ref": "refs/heads/main",
          },
          "status": "promoted",
        },
      ],
      "properties": {
        "refUpdate": {
          "$ref": "#/$defs/RefUpdate",
          "description": "How \`into\` moved; oldSha is all zeros when promote created it.",
        },
        "status": {
          "const": "promoted",
          "description": "\`into\` now points at \`sha\`.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "refUpdate",
      ],
      "title": "promote: promoted",
      "type": "object",
    },
    "PromoteUpToDate": {
      "additionalProperties": false,
      "description": "promote() found \`into\` already at \`sha\`.",
      "examples": [
        {
          "head": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "status": "up_to_date",
        },
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/Sha",
          "description": "The head of \`into\`, equal to \`sha\`.",
        },
        "status": {
          "const": "up_to_date",
          "description": "\`into\` already points at \`sha\`; nothing changed.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "head",
      ],
      "title": "promote: up to date",
      "type": "object",
    },
    "PushPolicyInput": {
      "additionalProperties": false,
      "description": "What PushPolicy.check() is given: the principal, the repository and every ref update of a push the branch policy allowed, with changed paths when the policy asked for them.",
      "examples": [
        {
          "principal": {
            "email": null,
            "expiresAt": null,
            "name": null,
            "roles": [
              "editor",
            ],
            "subject": "alice",
          },
          "repo": "acme-site",
          "updates": [
            {
              "commits": null,
              "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
              "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
              "ref": "refs/heads/main",
            },
          ],
        },
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/Principal",
          "description": "Who is pushing, as the Authenticator established it.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "The repository pushed to.",
        },
        "updates": {
          "description": "Every update of the push, in the order the client sent them; all passed the branch policy.",
          "items": {
            "$ref": "#/$defs/PushPolicyUpdate",
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "principal",
        "repo",
        "updates",
      ],
      "title": "Push policy input",
      "type": "object",
    },
    "PushPolicyNeeds": {
      "additionalProperties": false,
      "description": "What PushPolicy.needs() returns for a push: whether check() needs the changed paths of every update.",
      "examples": [
        {
          "changedPaths": true,
        },
      ],
      "properties": {
        "changedPaths": {
          "description": "true to be given, for every update, the commits it brings with the paths each changes (PushPolicyUpdate.commits). That means buffering and reading the pushed pack and reading trees from storage, bounded by SmartHttpConfig.maxPushPolicyPackBytes, maxPushPolicyObjectBytes, maxPushPolicyReads and maxChangedPaths; a push past a bound is refused as uncheckable. false to decide from the ref updates alone, before the pack is read (\`commits\` is then null).",
          "type": "boolean",
        },
      },
      "required": [
        "changedPaths",
      ],
      "title": "Push policy needs",
      "type": "object",
    },
    "PushPolicyResult": {
      "additionalProperties": false,
      "description": "The push policy verdict on every ref update of one push. It runs after the branch policy, and the push is written only when both allow every update.",
      "examples": [
        {
          "refs": [
            {
              "decision": "deny",
              "reason": "files over 10 MiB are not accepted: video.mp4",
              "ref": "refs/heads/main",
            },
            {
              "decision": "allow",
              "ref": "refs/heads/feature/x",
            },
          ],
        },
      ],
      "properties": {
        "refs": {
          "description": "One decision per update the policy was given, each ref named at most once. An update without a decision is refused, and a push is written only when every update is allowed; otherwise each refused ref is reported with its reason and the rest as "not updated: another update in this push was refused".",
          "items": {
            "$ref": "#/$defs/PushRefDecision",
          },
          "maxItems": 10000,
          "type": "array",
        },
      },
      "required": [
        "refs",
      ],
      "title": "Push policy result",
      "type": "object",
    },
    "PushPolicyUpdate": {
      "additionalProperties": false,
      "description": "One ref update of a push and, when the policy asked for them, the commits it brings.",
      "examples": [
        {
          "commits": null,
          "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "ref": "refs/heads/main",
        },
      ],
      "properties": {
        "commits": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PushedCommit",
              },
              "maxItems": 100000,
              "type": "array",
            },
            {
              "type": "null",
            },
          ],
          "description": "The commits new to the repository that the update brings — those of the pushed pack reachable from \`newSha\` — newest first (breadth-first from \`newSha\`), each with its changed paths. Empty for a deletion, or when \`newSha\` is a commit storage already has. Null when the policy did not ask for changed paths (PushPolicyNeeds.changedPaths false).",
        },
        "newSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the ref will name; the all-zero id when the update deletes the ref.",
        },
        "oldSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the ref names now; the all-zero id when the update creates the ref.",
        },
        "ref": {
          "$ref": "#/$defs/FullRefName",
          "description": "The ref the update names, fully qualified.",
        },
      },
      "required": [
        "ref",
        "oldSha",
        "newSha",
        "commits",
      ],
      "title": "Push policy update",
      "type": "object",
    },
    "PushRefDecision": {
      "description": "The push policy verdict on one ref update: allow it, or deny it with a reason git shows.",
      "examples": [
        {
          "decision": "deny",
          "reason": "generated/ is written by the build pipeline",
          "ref": "refs/heads/main",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/RefDecisionAllow",
        },
        {
          "$ref": "#/$defs/RefDecisionDeny",
        },
      ],
      "title": "Push ref decision",
    },
    "PushedCommit": {
      "additionalProperties": false,
      "description": "A commit new to the repository that a ref update brings (it is in the pushed pack), with the paths it changes.",
      "examples": [
        {
          "changes": [
            {
              "change": "added",
              "newMode": "100644",
              "newSha": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
              "oldMode": null,
              "oldSha": null,
              "path": "README.md",
              "size": 0,
            },
          ],
          "parents": [
            "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          ],
          "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
        },
      ],
      "properties": {
        "changes": {
          "description": "The paths the commit changes. Against its parent for an ordinary commit and against the empty tree for a root commit; for a merge, only the paths whose result differs from every parent (git's combined diff), since anything matching one parent came from that parent. Sorted by path.",
          "items": {
            "$ref": "#/$defs/ChangedPath",
          },
          "maxItems": 100000,
          "type": "array",
        },
        "parents": {
          "description": "Parent ids in order.",
          "items": {
            "$ref": "#/$defs/Sha",
            "description": "A parent commit id.",
          },
          "maxItems": 1000,
          "type": "array",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "The commit id.",
        },
      },
      "required": [
        "sha",
        "parents",
        "changes",
      ],
      "title": "Pushed commit",
      "type": "object",
    },
    "ReadContent": {
      "description": "File content returned by a read, interpreted according to the accompanying encoding: UTF-8 text, or base64 of the raw bytes. Not length-capped: base64 output is 4/3 the size of the bytes and files can arrive over git push at any size, so a read returns whatever the repository holds. An empty string is an empty file.",
      "examples": [
        "# Hello
",
        "iVBORw0KGgo=",
      ],
      "title": "Read content",
      "type": "string",
    },
    "ReadFileInput": {
      "additionalProperties": false,
      "description": "Input of readFile(): one file at a branch or commit. Fails with ref_not_found if the ref is missing.",
      "examples": [
        {
          "encoding": "text",
          "path": "content/about.md",
          "ref": "main",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "Preferred encoding of the returned content. "text" (default) returns text when the bytes are valid UTF-8 and falls back to base64 otherwise; "base64" always returns base64.",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the file to read.",
        },
        "ref": {
          "$ref": "#/$defs/Revision",
          "description": "Branch name or commit id to read the file at.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to read from.",
        },
      },
      "required": [
        "repo",
        "ref",
        "path",
        "encoding",
      ],
      "title": "readFile input",
      "type": "object",
    },
    "ReadFileOutput": {
      "anyOf": [
        {
          "$ref": "#/$defs/FileRead",
        },
        {
          "type": "null",
        },
      ],
      "description": "Output of readFile(): the file, or null when the path is not a file at that ref (absent or a directory).",
      "examples": [
        null,
      ],
      "title": "readFile output",
    },
    "RefDecision": {
      "description": "The branch policy verdict on one ref update, discriminated by \`decision\`.",
      "examples": [
        {
          "decision": "deny",
          "reason": "main is protected",
          "ref": "refs/heads/main",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/RefDecisionAllow",
        },
        {
          "$ref": "#/$defs/RefDecisionFastForwardOnly",
        },
        {
          "$ref": "#/$defs/RefDecisionDeny",
        },
      ],
      "title": "Ref decision",
    },
    "RefDecisionAllow": {
      "additionalProperties": false,
      "description": "The branch policy allows this update as it stands, force pushes included.",
      "examples": [
        {
          "decision": "allow",
          "ref": "refs/heads/feature/x",
        },
      ],
      "properties": {
        "decision": {
          "const": "allow",
          "description": "The update may proceed, whether or not it is a fast-forward.",
          "type": "string",
        },
        "ref": {
          "$ref": "#/$defs/FullRefName",
          "description": "The ref the update names.",
        },
      },
      "required": [
        "ref",
        "decision",
      ],
      "title": "Ref decision: allow",
      "type": "object",
    },
    "RefDecisionDeny": {
      "additionalProperties": false,
      "description": "The branch policy refuses this update; git shows \`reason\` to the user.",
      "examples": [
        {
          "decision": "deny",
          "reason": "main is protected",
          "ref": "refs/heads/main",
        },
      ],
      "properties": {
        "decision": {
          "const": "deny",
          "description": "The update is refused.",
          "type": "string",
        },
        "reason": {
          "description": "Why the update is or would be refused, shown to the user by git as "! [remote rejected] <ref> (<reason>)": one line of 1–500 characters.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^[^\\n\\0]+$",
          "type": "string",
        },
        "ref": {
          "$ref": "#/$defs/FullRefName",
          "description": "The ref the update names.",
        },
      },
      "required": [
        "ref",
        "decision",
        "reason",
      ],
      "title": "Ref decision: deny",
      "type": "object",
    },
    "RefDecisionFastForwardOnly": {
      "additionalProperties": false,
      "description": "The branch policy allows this update only as a fast-forward. The gateway proves the new commit descends from the old one (from the pushed pack and the backend) and refuses with \`reason\` when it does not or cannot be shown to. Creating a ref is allowed (there is no old head to lose); deleting one is refused with \`reason\` (there is no new commit to contain the old head). Moving an existing tag is never a fast-forward.",
      "examples": [
        {
          "decision": "fast-forward-only",
          "reason": "force pushes to main are not allowed",
          "ref": "refs/heads/main",
        },
      ],
      "properties": {
        "decision": {
          "const": "fast-forward-only",
          "description": "The update may proceed only if the new commit contains the current head; the gateway checks ancestry and refuses otherwise. A creation (no current head) proceeds; a deletion (no new commit) is refused.",
          "type": "string",
        },
        "reason": {
          "description": "Why the update is or would be refused, shown to the user by git as "! [remote rejected] <ref> (<reason>)": one line of 1–500 characters.",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^[^\\n\\0]+$",
          "type": "string",
        },
        "ref": {
          "$ref": "#/$defs/FullRefName",
          "description": "The ref the update names.",
        },
      },
      "required": [
        "ref",
        "decision",
        "reason",
      ],
      "title": "Ref decision: fast-forward only",
      "type": "object",
    },
    "RefPattern": {
      "description": "A glob matched against a whole fully qualified ref under refs/heads/ or refs/tags/: "*" matches any run of characters inside one path component (never "/"), "**" matches any run including "/", everything else matches itself. No "..", "//", trailing "/", whitespace, control characters, ~ ^ : ? [ or backslash; 12–266 characters.",
      "examples": [
        "refs/heads/main",
        "refs/heads/release/*",
        "refs/tags/**",
      ],
      "maxLength": 266,
      "minLength": 12,
      "pattern": "^refs\\/(?:heads|tags)\\/(?!.*\\.\\.)(?!.*\\/\\/)(?!.*\\/$)(?!.*\\*{3})[^\\x00-\\x20\\x7f~^:?[\\\\]+$",
      "title": "Ref pattern",
      "type": "string",
    },
    "RefUpdate": {
      "additionalProperties": false,
      "description": "One ref moved by a write, in receive-pack command form: the ref, the id it named before and the id it names after. Creation and deletion use the all-zero id on the missing side.",
      "examples": [
        {
          "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "ref": "refs/heads/main",
        },
      ],
      "properties": {
        "newSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the ref points at after the update; the all-zero id when the update deleted the ref.",
        },
        "oldSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the ref pointed at before the update; the all-zero id when the update created the ref.",
        },
        "ref": {
          "$ref": "#/$defs/FullRefName",
          "description": "The ref that moved, fully qualified (refs/heads/<branch>).",
        },
      },
      "required": [
        "ref",
        "oldSha",
        "newSha",
      ],
      "title": "Ref update",
      "type": "object",
    },
    "RepoInfo": {
      "additionalProperties": false,
      "description": "A repository behind the gateway.",
      "examples": [
        {
          "createdAt": "2026-11-20T09:30:00.000Z",
          "defaultBranch": "main",
          "name": "acme-raw-content",
          "remoteUrl": "https://git.example.com/acme-raw-content.git",
        },
      ],
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the repository was created.",
        },
        "defaultBranch": {
          "$ref": "#/$defs/BranchName",
          "description": "The branch HEAD names.",
        },
        "name": {
          "$ref": "#/$defs/RepoName",
          "description": "The repository name.",
        },
        "remoteUrl": {
          "description": "Clone URL of the repository on the gateway: <publicBaseUrl>/<name>.git.",
          "format": "uri",
          "type": "string",
        },
      },
      "required": [
        "name",
        "defaultBranch",
        "createdAt",
        "remoteUrl",
      ],
      "title": "Repository",
      "type": "object",
    },
    "RepoName": {
      "description": "Name of a repository behind the gateway: 1–100 characters of letters, digits, ".", "_" and "-", starting with a letter or digit and not ending in ".git". Served at /<name>.git.",
      "examples": [
        "acme-raw-content",
        "site.example",
      ],
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Repository name",
      "type": "string",
    },
    "RequestId": {
      "description": "Identifies one request in logs, audit events and the X-Request-Id response header: 1–128 characters of letters, digits, ".", "_", ":" and "-". The Cloudflare Ray id when there is one, otherwise a random UUID.",
      "examples": [
        "8f1c2d3e4a5b6c7d-LHR",
        "6f1d2c3b-9a8e-4f7d-b6c5-a4e3d2c1b0a9",
      ],
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Request id",
      "type": "string",
    },
    "ResolveRefInput": {
      "additionalProperties": false,
      "description": "Input of resolveRef(): resolve a branch to its head, or confirm a commit id exists.",
      "examples": [
        {
          "ref": "main",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/Revision",
          "description": "Branch name to resolve, or commit id to check.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to look in.",
        },
      },
      "required": [
        "repo",
        "ref",
      ],
      "title": "resolveRef input",
      "type": "object",
    },
    "ResolveRefOutput": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "sha": {
              "$ref": "#/$defs/Sha",
              "description": "Id of the commit the ref names.",
            },
          },
          "required": [
            "sha",
          ],
          "type": "object",
        },
        {
          "type": "null",
        },
      ],
      "description": "Output of resolveRef(): the commit id the ref names, or null when the branch or commit does not exist.",
      "examples": [
        {
          "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
        },
        null,
      ],
      "title": "resolveRef output",
    },
    "Revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha",
          "description": "A commit id. Any 40-character lowercase hex string is read as a commit id, never a branch.",
        },
        {
          "$ref": "#/$defs/BranchName",
          "description": "A branch name, resolved to the branch head at the time of the call.",
        },
      ],
      "description": "What a read is made against: a 40-character lowercase hex commit id, or a short branch name resolved to its current head.",
      "examples": [
        "main",
        "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
      ],
      "title": "Revision",
    },
    "Role": {
      "description": "A role or group the deployment grants a principal, matched by branch-policy rules and authorizers: 1–100 characters without whitespace or NUL. Case-sensitive.",
      "examples": [
        "maintainer",
        "site:acme:editor",
      ],
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\s\\0]+$",
      "title": "Role",
      "type": "string",
    },
    "Sha": {
      "description": "A git object id: 40-character lowercase hex SHA-1 naming a commit, tree or blob. Never abbreviated.",
      "examples": [
        "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
      ],
      "pattern": "^[0-9a-f]{40}$",
      "title": "Object id",
      "type": "string",
    },
    "Signature": {
      "additionalProperties": false,
      "description": "An identity together with the time it authored or committed a commit, as stored in the commit.",
      "examples": [
        {
          "date": "2026-11-20T09:30:00.000Z",
          "email": "ada@example.com",
          "name": "Ada Lovelace",
        },
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/Timestamp",
          "description": "When this person authored or committed the change, as an ISO 8601 UTC timestamp.",
        },
        "email": {
          "description": "Email address, at most 255 characters.",
          "format": "email",
          "maxLength": 255,
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string",
        },
        "name": {
          "description": "Display name, 1–255 characters, without "<", ">", newlines or NUL (git cannot store them).",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^<>\\n\\0]+$",
          "type": "string",
        },
      },
      "required": [
        "name",
        "email",
        "date",
      ],
      "title": "Signature",
      "type": "object",
    },
    "SmartHttpConfig": {
      "additionalProperties": false,
      "description": "Limits and names used by the smart-HTTP proxy. Every field has a default, so {} is a complete configuration.",
      "examples": [
        {
          "allowedPushOptions": [
            "ci.skip",
          ],
          "decisionCacheEntries": 10000,
          "deniedStatus": "err",
          "maxAncestryReads": 2000,
          "maxAuditReportBytes": 1048576,
          "maxChangedPaths": 10000,
          "maxFastForwardPackBytes": 33554432,
          "maxPushHeadBytes": 8388608,
          "maxPushPolicyObjectBytes": 67108864,
          "maxPushPolicyPackBytes": 33554432,
          "maxPushPolicyReads": 2000,
          "maxScannedCommitBytes": 33554432,
          "maxVerdictWaitMs": 60000,
          "realm": "git-gateway",
        },
      ],
      "properties": {
        "allowedPushOptions": {
          "default": [],
          "description": "Push option names the proxy forwards to the storage host; a push carrying any other option is refused before it reaches storage. The host runs push options as the gateway's own credential (GitLab's merge_request.* and ci.variable, for example), so each one bypasses branch policy unless refused here. At most 100; default none, so every push option is refused.",
          "items": {
            "description": "A push option name, the part of a "git push -o <name>[=<value>]" option before the first "="; 1–100 characters without whitespace, NUL or "=". Matched exactly and case-sensitively.",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[^\\s\\0=]+$",
            "type": "string",
          },
          "maxItems": 100,
          "type": "array",
        },
        "decisionCacheEntries": {
          "default": 10000,
          "description": "Most authentication and authorization decisions held in the per-isolate cache, oldest evicted first; 0 disables the cache. Default 10000. How long entries live is GatewayConfig.authCacheSeconds.",
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer",
        },
        "deniedStatus": {
          "anyOf": [
            {
              "const": "err",
              "description": "Answer in-protocol: HTTP 200 with an "ERR" packet, which git prints as "remote error: <reason>".",
              "type": "string",
            },
            {
              "const": 403,
              "description": "Answer HTTP 403 with the reason as a plain-text body, which git prints as "The requested URL returned error: 403".",
              "type": "number",
            },
          ],
          "default": "err",
          "description": "How an authorization refusal (the Authorizer denying read or write of a repository) is answered: "err" (default) or 403. Branch-policy refusals of individual refs are always in-protocol ("ng" or "ERR"), so a push to a protected branch keeps its readable reason either way.",
        },
        "maxAncestryReads": {
          "default": 2000,
          "description": "Most commits read from the storage backend to prove that a fast-forward-only update is a fast-forward; past it the update is refused as unverifiable. 1–100000, default 2000.",
          "maximum": 100000,
          "minimum": 1,
          "type": "integer",
        },
        "maxAuditReportBytes": {
          "default": 1048576,
          "description": "Most bytes of a storage host push response kept to read its per-ref report for the audit event and the push event; past it the refs are audited as "unknown" and no push event is sent. 0 skips reading reports for audit; when an onPush hook is set the report is still read, up to the 1 MiB default. Default 1 MiB (1048576).",
          "maximum": 16777216,
          "minimum": 0,
          "type": "integer",
        },
        "maxChangedPaths": {
          "default": 10000,
          "description": "Most changed paths, summed over every commit of a push, given to the push policy; a push changing more is refused as uncheckable. 1–100000, default 10000.",
          "maximum": 100000,
          "minimum": 1,
          "type": "integer",
        },
        "maxFastForwardPackBytes": {
          "default": 33554432,
          "description": "Most bytes of a pushed pack held in memory while fast-forward-only updates whose new commit is in the pack are proven from it; the push is read whole and proven, storage reads included, before anything is sent to the storage host. A larger pack is streamed to the host instead, its pack checksum held back, and its updates proven from the pack alone without reading storage while the host request is open; an update whose proof would need commits from storage is then refused as unverifiable. 1 MiB–256 MiB, default 32 MiB (33554432).",
          "maximum": 268435456,
          "minimum": 1048576,
          "type": "integer",
        },
        "maxPushHeadBytes": {
          "default": 8388608,
          "description": "Most bytes of a push read before the pack (update commands, capabilities, push options); a larger head is refused. 4 KiB–64 MiB, default 8 MiB (8388608).",
          "maximum": 67108864,
          "minimum": 4096,
          "type": "integer",
        },
        "maxPushPolicyObjectBytes": {
          "default": 67108864,
          "description": "Most bytes of objects decompressed and rebuilt from the pushed pack (every entry's data plus every delta's result, thin-pack bases read from storage included) to compute changed paths; past it the push is refused as uncheckable. 1 MiB–512 MiB, default 64 MiB (67108864).",
          "maximum": 536870912,
          "minimum": 1048576,
          "type": "integer",
        },
        "maxPushPolicyPackBytes": {
          "default": 33554432,
          "description": "Most bytes of a pushed pack held in memory so the push policy can be given changed paths (only when PushPolicy.needs() asks for them); the push is read whole and checked before anything is sent to the storage host, and a larger push is refused as uncheckable. 1 MiB–256 MiB, default 32 MiB (33554432).",
          "maximum": 268435456,
          "minimum": 1048576,
          "type": "integer",
        },
        "maxPushPolicyReads": {
          "default": 2000,
          "description": "Most storage backend calls made to compute changed paths for the push policy — parent commits, trees and blobs not in the pushed pack (thin-pack delta bases, unchanged subtrees of a moved directory, sizes of blobs storage already has); past it the push is refused as uncheckable. 1–100000, default 2000.",
          "maximum": 100000,
          "minimum": 1,
          "type": "integer",
        },
        "maxScannedCommitBytes": {
          "default": 33554432,
          "description": "Most bytes of commit objects kept while scanning a pushed pack for ancestry; a push needing more is refused as unverifiable. 1 MiB–256 MiB, default 32 MiB (33554432).",
          "maximum": 268435456,
          "minimum": 1048576,
          "type": "integer",
        },
        "maxVerdictWaitMs": {
          "default": 60000,
          "description": "Most milliseconds a streamed push (one whose pack is larger than maxFastForwardPackBytes, proven from the pack as it passes) waits, once the storage host's request has failed, for the gateway to finish proving it, so that a refusal (which makes the host's request fail by design) is reported in-protocol as "ng <ref> <reason>" rather than as a 502. Past it, or when no verdict comes, the push is answered 502 and nothing is written. A push read whole is decided before the host is asked and never waits. 0–600000, default 60000 (one minute).",
          "maximum": 600000,
          "minimum": 0,
          "type": "integer",
        },
        "realm": {
          "default": "git-gateway",
          "description": "Realm named in the WWW-Authenticate: Basic challenge of a 401, which git credential helpers show and key on; 1–100 characters without quotes, backslash, newline or NUL. Default "git-gateway".",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^"\\\\\\n\\0]+$",
          "type": "string",
        },
      },
      "required": [
        "realm",
        "maxPushHeadBytes",
        "maxAncestryReads",
        "maxScannedCommitBytes",
        "maxFastForwardPackBytes",
        "maxVerdictWaitMs",
        "maxPushPolicyPackBytes",
        "maxPushPolicyObjectBytes",
        "maxPushPolicyReads",
        "maxChangedPaths",
        "decisionCacheEntries",
        "maxAuditReportBytes",
        "allowedPushOptions",
        "deniedStatus",
      ],
      "title": "Smart-HTTP proxy configuration",
      "type": "object",
    },
    "SmartHttpEndpoint": {
      "description": "Which of the three git smart-HTTP endpoints of /<repo>.git a request reached.",
      "enum": [
        "info-refs",
        "upload-pack",
        "receive-pack",
      ],
      "enumDescriptions": {
        "info-refs": "GET /<repo>.git/info/refs?service=…: the ref advertisement (or the protocol v2 capabilities).",
        "receive-pack": "POST /<repo>.git/git-receive-pack: ref update commands and the pack pushed by the client.",
        "upload-pack": "POST /<repo>.git/git-upload-pack: fetch negotiation and the pack sent to the client.",
      },
      "examples": [
        "receive-pack",
      ],
      "title": "Smart-HTTP endpoint",
      "type": "string",
    },
    "StorageLogOptions": {
      "additionalProperties": false,
      "description": "Paging of StorageBackend.log(), which lists the first-parent chain from a revision, newest first: skip \`offset\` commits, then return up to \`limit\`.",
      "examples": [
        {
          "limit": 50,
          "offset": 0,
        },
      ],
      "properties": {
        "limit": {
          "description": "Most commits returned: 1–1000. Fewer come back when the history is shorter.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Commits skipped from the newest before listing. Default 0.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "limit",
        "offset",
      ],
      "title": "Storage log options",
      "type": "object",
    },
    "StorageRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/FullRefName",
          "description": "A fully qualified ref, "refs/heads/<branch>" or "refs/tags/<tag>", resolved exactly.",
        },
        {
          "$ref": "#/$defs/BranchName",
          "description": "A short branch name, resolved as "refs/heads/<name>".",
        },
      ],
      "description": "A ref StorageBackend.resolveRef() resolves: a fully qualified "refs/heads/…" or "refs/tags/…" ref, or a short branch name meaning "refs/heads/<name>".",
      "examples": [
        "main",
        "refs/heads/staging",
        "refs/tags/v1.0.0",
      ],
      "title": "Storage ref",
    },
    "StorageRepoInfo": {
      "additionalProperties": false,
      "description": "A repository as a StorageBackend reports it: name, default branch and creation time. Carries no host URL or credential; those come only from gitRemote().",
      "examples": [
        {
          "createdAt": "2026-11-20T09:30:00.000Z",
          "defaultBranch": "main",
          "name": "acme-raw-content",
        },
      ],
      "properties": {
        "createdAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp",
            },
            {
              "type": "null",
            },
          ],
          "description": "When the storage host created the repository, as an ISO 8601 UTC timestamp; null when the host does not report it.",
        },
        "defaultBranch": {
          "$ref": "#/$defs/BranchName",
          "description": "The branch the repository's HEAD names on the storage host.",
        },
        "name": {
          "$ref": "#/$defs/RepoName",
          "description": "The repository name, the same name the gateway serves it under.",
        },
      },
      "required": [
        "name",
        "defaultBranch",
        "createdAt",
      ],
      "title": "Storage repository",
      "type": "object",
    },
    "StorageTreeEntry": {
      "additionalProperties": false,
      "description": "One entry of a git tree object read by its id through StorageBackend.readTree(): the name within that tree, the kind of object, its mode and its id. A contract TreeEntry without the path, which a tree read by id cannot know. Entries come back in the order git stores them.",
      "examples": [
        {
          "mode": "100644",
          "name": "about.md",
          "sha": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
          "type": "blob",
        },
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/FileMode",
        },
        "name": {
          "description": "Last segment of the path: 1–255 characters without "/" or NUL.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/\\0]+$",
          "type": "string",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the blob, tree or submodule commit the entry names.",
        },
        "type": {
          "$ref": "#/$defs/TreeEntryType",
        },
      },
      "required": [
        "name",
        "type",
        "mode",
        "sha",
      ],
      "title": "Storage tree entry",
      "type": "object",
    },
    "SyncBranchInput": {
      "additionalProperties": false,
      "description": "Input of syncBranch(): bring \`into\` up to date with \`from\` without rewriting \`into\`. Fails with ref_not_found if either branch is missing and unrelated_histories if they share no ancestor.",
      "examples": [
        {
          "from": "main",
          "into": "staging",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "author": {
          "$ref": "#/$defs/Identity",
          "description": "Author and committer of a merge commit, if one is needed. Absent: the configured service identity.",
        },
        "from": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch whose commits are brought into \`into\`.",
        },
        "into": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch brought up to date; never rewritten, only fast-forwarded or merged into.",
        },
        "message": {
          "description": "Message of a merge commit, if one is needed. Absent: "Merge branch '<from>' into <into>".",
          "maxLength": 65536,
          "minLength": 1,
          "type": "string",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository holding both branches.",
        },
      },
      "required": [
        "repo",
        "from",
        "into",
      ],
      "title": "syncBranch input",
      "type": "object",
    },
    "SyncBranchOutput": {
      "description": "Output of syncBranch(), discriminated by \`status\`.",
      "examples": [
        {
          "head": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "status": "up_to_date",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/SyncUpToDate",
        },
        {
          "$ref": "#/$defs/SyncFastForward",
        },
        {
          "$ref": "#/$defs/SyncMerged",
        },
        {
          "$ref": "#/$defs/SyncConflict",
        },
      ],
      "title": "syncBranch output",
    },
    "SyncConflict": {
      "additionalProperties": false,
      "description": "syncBranch() could not merge: the listed paths conflict. \`into\` is unchanged.",
      "examples": [
        {
          "base": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
          "fromHead": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "intoHead": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "paths": [
            "content/about.md",
          ],
          "status": "conflict",
        },
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/Sha",
          "description": "The merge base used.",
        },
        "fromHead": {
          "$ref": "#/$defs/Sha",
          "description": "The head of \`from\` merged.",
        },
        "intoHead": {
          "$ref": "#/$defs/Sha",
          "description": "The head of \`into\`, unchanged.",
        },
        "paths": {
          "description": "Every conflicting path, sorted in byte order: changed differently on both sides, or a file on one side where the other has a directory.",
          "items": {
            "$ref": "#/$defs/FilePath",
            "description": "A conflicting path.",
          },
          "minItems": 1,
          "type": "array",
        },
        "status": {
          "const": "conflict",
          "description": "Some paths changed differently on both sides; nothing was written.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "paths",
        "base",
        "fromHead",
        "intoHead",
      ],
      "title": "syncBranch: conflict",
      "type": "object",
    },
    "SyncFastForward": {
      "additionalProperties": false,
      "description": "syncBranch() fast-forwarded \`into\` to the head of \`from\` with a ref update naming the old head.",
      "examples": [
        {
          "refUpdate": {
            "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            "ref": "refs/heads/staging",
          },
          "status": "fast_forward",
        },
      ],
      "properties": {
        "refUpdate": {
          "$ref": "#/$defs/RefUpdate",
          "description": "How \`into\` moved.",
        },
        "status": {
          "const": "fast_forward",
          "description": "\`into\` had no commits of its own and now points at the head of \`from\`.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "refUpdate",
      ],
      "title": "syncBranch: fast-forward",
      "type": "object",
    },
    "SyncMerged": {
      "additionalProperties": false,
      "description": "syncBranch() merged file by file against the merge base: a path changed on one side takes that side.",
      "examples": [
        {
          "commit": {
            "author": {
              "date": "2026-11-20T09:30:00.000Z",
              "email": "ada@example.com",
              "name": "Ada Lovelace",
            },
            "committer": {
              "date": "2026-11-20T09:30:00.000Z",
              "email": "ada@example.com",
              "name": "Ada Lovelace",
            },
            "idempotencyKey": "cms:publish:2f9c1e",
            "message": "Update about page

Gateway-Idempotency-Key: cms:publish:2f9c1e
",
            "parents": [
              "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            ],
            "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
          },
          "refUpdate": {
            "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            "ref": "refs/heads/staging",
          },
          "status": "merged",
        },
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/Commit",
          "description": "The merge commit; its parents are the old head of \`into\`, then the head of \`from\`.",
        },
        "refUpdate": {
          "$ref": "#/$defs/RefUpdate",
          "description": "How \`into\` moved.",
        },
        "status": {
          "const": "merged",
          "description": "Both branches had commits; a file-level merge commit was written to \`into\`.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "commit",
        "refUpdate",
      ],
      "title": "syncBranch: merged",
      "type": "object",
    },
    "SyncRule": {
      "additionalProperties": false,
      "description": "An onPush rule: after any push to \`from\`, run syncBranch({ from, into }) as a SyncBranchWorkflow with retries.",
      "examples": [
        {
          "from": "main",
          "into": "staging",
        },
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/BranchName",
          "description": "The branch whose pushes trigger the sync.",
        },
        "into": {
          "$ref": "#/$defs/BranchName",
          "description": "The branch brought up to date with \`from\` by syncBranch.",
        },
      },
      "required": [
        "from",
        "into",
      ],
      "title": "Sync rule",
      "type": "object",
    },
    "SyncUpToDate": {
      "additionalProperties": false,
      "description": "syncBranch() found that \`into\` already contains the head of \`from\`.",
      "examples": [
        {
          "head": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "status": "up_to_date",
        },
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/Sha",
          "description": "The head of \`into\`, unchanged.",
        },
        "status": {
          "const": "up_to_date",
          "description": "\`into\` already contains the head of \`from\`; nothing changed.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "head",
      ],
      "title": "syncBranch: up to date",
      "type": "object",
    },
    "Timestamp": {
      "description": "A point in time as an ISO 8601 UTC timestamp ending in "Z", with optional fractional seconds (e.g. 2026-11-20T09:30:00.000Z).",
      "examples": [
        "2026-11-20T09:30:00.000Z",
      ],
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "title": "Timestamp",
      "type": "string",
    },
    "TreeEntry": {
      "additionalProperties": false,
      "description": "One entry of a directory listing: a file, directory, symbolic link or submodule.",
      "examples": [
        {
          "mode": "100644",
          "name": "about.md",
          "path": "content/about.md",
          "sha": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
          "type": "blob",
        },
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/FileMode",
        },
        "name": {
          "description": "Last segment of the path: 1–255 characters without "/" or NUL.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/\\0]+$",
          "type": "string",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Full path of the entry from the repository root.",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the blob, tree or submodule commit the entry names.",
        },
        "type": {
          "$ref": "#/$defs/TreeEntryType",
        },
      },
      "required": [
        "path",
        "name",
        "type",
        "mode",
        "sha",
      ],
      "title": "Tree entry",
      "type": "object",
    },
    "TreeEntryType": {
      "description": "The kind of object a tree entry names.",
      "enum": [
        "blob",
        "tree",
        "commit",
      ],
      "enumDescriptions": {
        "blob": "A file or symbolic link (modes 100644, 100755, 120000).",
        "commit": "A submodule commit in another repository (mode 160000).",
        "tree": "A directory (mode 040000).",
      },
      "examples": [
        "blob",
        "tree",
      ],
      "title": "Tree entry type",
      "type": "string",
    },
    "TreeListing": {
      "additionalProperties": false,
      "description": "A directory listing at a commit.",
      "examples": [
        {
          "commit": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "entries": [
            {
              "mode": "100644",
              "name": "about.md",
              "path": "content/about.md",
              "sha": "f2a5b0a7d1d3d1f1c1c3e7e5d2b9b7e1a3c5d7e9",
              "type": "blob",
            },
          ],
          "path": "content",
        },
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the commit listed (the ref resolved).",
        },
        "entries": {
          "description": "Entries sorted by full path in byte order; empty for a repository root with no files.",
          "items": {
            "$ref": "#/$defs/TreeEntry",
          },
          "type": "array",
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilePath",
            },
            {
              "type": "null",
            },
          ],
          "description": "The directory listed; null for the repository root.",
        },
      },
      "required": [
        "commit",
        "path",
        "entries",
      ],
      "title": "Tree listing",
      "type": "object",
    },
    "UpdateAction": {
      "additionalProperties": false,
      "description": "Replaces the content of an existing file, keeping its executable bit. Fails with path_not_found if the path is not a file.",
      "examples": [
        {
          "action": "update",
          "content": "# About us
",
          "encoding": "text",
          "path": "content/about.md",
        },
      ],
      "properties": {
        "action": {
          "const": "update",
          "description": "Replace an existing file. Fails with path_not_found if it is absent.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "New content of the file, encoded as \`encoding\` says.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the existing file to replace.",
        },
      },
      "required": [
        "action",
        "path",
        "content",
        "encoding",
      ],
      "title": "Update action",
      "type": "object",
    },
    "UpsertAction": {
      "additionalProperties": false,
      "description": "Creates the file, or replaces it (keeping its executable bit) if it exists. Fails with path_exists if the path is a directory and path_conflict if a parent is a file. Not part of the GitLab Commits API.",
      "examples": [
        {
          "action": "upsert",
          "content": "iVBORw0KGgo=",
          "encoding": "base64",
          "path": "assets/logo.png",
        },
      ],
      "properties": {
        "action": {
          "const": "upsert",
          "description": "Create the file, or replace it if it exists.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "Content of the file, encoded as \`encoding\` says.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the file to create or replace.",
        },
      },
      "required": [
        "action",
        "path",
        "content",
        "encoding",
      ],
      "title": "Upsert action",
      "type": "object",
    },
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
}
`;
