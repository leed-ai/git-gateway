              "description": "The commit the caller asked to promote.",
            },
          },
          "required": [
            "from",
            "sha",
            "head",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "not_head_of_source error",
      "type": "object",
    },
    "GatewayError.path_conflict": {
      "additionalProperties": false,
      "description": "An action would place a file beneath a path that is itself a file.",
      "examples": [
        {
          "code": "path_conflict",
          "details": {
            "conflictingPath": "a",
            "path": "a/b.md",
          },
          "message": "A parent of the path is a file",
        },
      ],
      "properties": {
        "code": {
          "const": "path_conflict",
          "description": "An action would place a file beneath a path that is itself a file.",
          "type": "string",
        },
        "details": {
          "additionalProperties": false,
          "description": "Machine-readable facts about the path_conflict error.",
          "properties": {
            "conflictingPath": {
              "$ref": "#/$defs/FilePath",
              "description": "The parent of \`path\` that is a file.",
            },
            "path": {
              "$ref": "#/$defs/FilePath",
              "description": "The path the action targeted.",
            },
          },
          "required": [
            "path",
            "conflictingPath",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "path_conflict error",
      "type": "object",
    },
    "GatewayError.path_exists": {
      "additionalProperties": false,
      "description": "A create, upsert or move action targeted a path that is already a file or a directory.",
      "examples": [
        {
          "code": "path_exists",
          "details": {
            "path": "content/about.md",
          },
          "message": "File already exists",
        },
      ],
      "properties": {
        "code": {
          "const": "path_exists",
          "description": "A create, upsert or move action targeted a path that is already a file or a directory.",
          "type": "string",
        },
        "details": {
          "additionalProperties": false,
          "description": "Machine-readable facts about the path_exists error.",
          "properties": {
            "path": {
              "$ref": "#/$defs/FilePath",
              "description": "The path that already exists.",
            },
          },
          "required": [
            "path",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "path_exists error",
      "type": "object",
    },
