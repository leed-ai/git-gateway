    "TreeEntryType": {
      "description": "The kind of object a tree entry names.",
      "enum": [
        "blob",
        "tree",
        "commit",
      ],
      "enumDescriptions": {
        "blob": "A file or symbolic link (modes 100644, 100755, 120000).",
        "commit": "A submodule commit in another repository (mode 160000).",
        "tree": "A directory (mode 040000).",
      },
      "examples": [
        "blob",
        "tree",
      ],
      "title": "Tree entry type",
      "type": "string",
    },
    "TreeListing": {
      "additionalProperties": false,
      "description": "A directory listing at a commit.",
      "examples": [
        {
          "commit": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "entries": [
            {
              "mode": "100644",
              "name": "about.md",
              "path": "content/about.md",
              "sha": "f2a5b0a7d1d3d1f1c1c3e7e5d2b9b7e1a3c5d7e9",
              "type": "blob",
            },
          ],
          "path": "content",
        },
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the commit listed (the ref resolved).",
        },
        "entries": {
          "description": "Entries sorted by full path in byte order; empty for a repository root with no files.",
          "items": {
            "$ref": "#/$defs/TreeEntry",
          },
          "type": "array",
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilePath",
            },
            {
              "type": "null",
            },
          ],
          "description": "The directory listed; null for the repository root.",
        },
      },
      "required": [
        "commit",
        "path",
        "entries",
      ],
      "title": "Tree listing",
      "type": "object",
    },
    "UpdateAction": {
      "additionalProperties": false,
      "description": "Replaces the content of an existing file, keeping its executable bit. Fails with path_not_found if the path is not a file.",
      "examples": [
        {
          "action": "update",
          "content": "# About us
",
          "encoding": "text",
          "path": "content/about.md",
        },
      ],
      "properties": {
        "action": {
          "const": "update",
          "description": "Replace an existing file. Fails with path_not_found if it is absent.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "New content of the file, encoded as \`encoding\` says.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the existing file to replace.",
        },
      },
      "required": [
        "action",
        "path",
        "content",
      ],
      "title": "Update action",
      "type": "object",
    },
    "UpsertAction": {
      "additionalProperties": false,
      "description": "Creates the file, or replaces it (keeping its executable bit) if it exists. Fails with path_exists if the path is a directory and path_conflict if a parent is a file. Not part of the GitLab Commits API.",
      "examples": [
        {
          "action": "upsert",
          "content": "iVBORw0KGgo=",
          "encoding": "base64",
          "path": "assets/logo.png",
        },
      ],
      "properties": {
        "action": {
          "const": "upsert",
          "description": "Create the file, or replace it if it exists.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "Content of the file, encoded as \`encoding\` says.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the file to create or replace.",
        },
      },
      "required": [
        "action",
        "path",
        "content",
      ],
      "title": "Upsert action",
      "type": "object",
    },
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
}
