            "sha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          },
          "message": "Not a fast-forward",
        },
      ],
      "properties": {
        "code": {
          "const": "not_fast_forward",
          "description": "promote named a commit that does not contain the head of the target branch; nothing moved.",
          "type": "string",
        },
        "details": {
          "additionalProperties": false,
          "description": "Machine-readable facts about the not_fast_forward error.",
          "properties": {
            "head": {
              "$ref": "#/$defs/Sha",
              "description": "The current head of the target branch, which \`sha\` does not contain.",
            },
            "into": {
              "$ref": "#/$defs/BranchName",
              "description": "The target branch.",
            },
            "sha": {
              "$ref": "#/$defs/Sha",
              "description": "The commit the caller asked to promote.",
            },
          },
          "required": [
            "into",
            "sha",
            "head",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "not_fast_forward error",
      "type": "object",
    },
    "GatewayError.not_head_of_source": {
      "additionalProperties": false,
      "description": "promote named a commit that is not the current head of the source branch; nothing moved.",
      "examples": [
