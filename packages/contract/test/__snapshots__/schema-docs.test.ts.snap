// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`schema documentation > generates the JSON Schema for what the schemas accept 1`] = `
{
  "$defs": {
    "AuditEvent": {
      "additionalProperties": false,
      "description": "Handed to the audit hook for every authenticated smart-HTTP request once it is decided: principal, repository, operation, refs and outcome. Never contains a credential.",
      "examples": [
        {
          "at": "2026-11-20T09:30:00.000Z",
          "endpoint": "receive-pack",
          "operation": "write",
          "outcome": "denied",
          "principal": {
            "email": null,
            "expiresAt": null,
            "name": null,
            "roles": [
              "editor",
            ],
            "subject": "user:42",
          },
          "reason": "main is protected",
          "refs": [
            {
              "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
              "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
              "reason": "main is protected",
              "ref": "refs/heads/main",
              "status": "rejected",
            },
          ],
          "repo": "acme-raw-content",
          "requestId": "6f1d2c3b-9a8e-4f7d-b6c5-a4e3d2c1b0a9",
        },
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the gateway finished deciding and forwarding the request.",
        },
        "endpoint": {
          "$ref": "#/$defs/SmartHttpEndpoint",
          "description": "Which smart-HTTP endpoint the request reached.",
        },
        "operation": {
          "$ref": "#/$defs/GitOperation",
          "description": "Whether the request reads or writes the repository.",
        },
        "outcome": {
          "description": "What the gateway did with the request.",
          "enum": [
            "allowed",
            "denied",
            "failed",
          ],
          "enumDescriptions": {
            "allowed": "Authorized and forwarded to storage; for a push, \`refs\` says what storage did with each ref.",
            "denied": "Refused by the authorizer or the branch policy; nothing reached storage.",
            "failed": "Authorized, but the gateway or the storage host failed before an answer was complete.",
          },
          "type": "string",
        },
        "principal": {
          "$ref": "#/$defs/Principal",
          "description": "Who made the request (never the credential).",
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Why the request was denied or failed, as the client was told; null when it was allowed.",
        },
        "refs": {
          "description": "For a push (receive-pack), every update command and its outcome; empty for every other request.",
          "items": {
            "$ref": "#/$defs/AuditRefOutcome",
          },
          "maxItems": 10000,
          "type": "array",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "The repository the request named.",
        },
        "requestId": {
          "$ref": "#/$defs/RequestId",
          "description": "The request this event records.",
        },
      },
      "required": [
        "requestId",
        "at",
        "principal",
        "repo",
        "operation",
        "endpoint",
        "outcome",
        "reason",
        "refs",
      ],
      "title": "Audit event",
      "type": "object",
    },
    "AuditRefOutcome": {
      "additionalProperties": false,
      "description": "One update command of an audited push and what became of it.",
      "examples": [
        {
          "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "reason": "main is protected",
          "ref": "refs/heads/main",
          "status": "rejected",
        },
      ],
      "properties": {
        "newSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the client asked the ref to name; all zeros when it asked to delete the ref.",
        },
        "oldSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the client said the ref named; all zeros when it asked to create the ref.",
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Why the update was refused, as git was told; null unless \`status\` is "rejected".",
        },
        "ref": {
          "description": "The ref the update command named, fully qualified; any namespace, since refused ones are audited too.",
          "maxLength": 4096,
          "minLength": 6,
          "pattern": "^refs\\/[^\\n\\0]+$",
          "type": "string",
        },
        "status": {
          "description": "What happened to the ref.",
          "enum": [
            "ok",
            "rejected",
            "unknown",
          ],
          "enumDescriptions": {
            "ok": "The storage host reported the ref updated.",
            "rejected": "The gateway or the storage host refused the update; \`reason\` says why.",
            "unknown": "The push was forwarded but the storage host report could not be read.",
          },
          "type": "string",
        },
      },
      "required": [
        "ref",
        "oldSha",
        "newSha",
        "status",
        "reason",
      ],
      "title": "Audited ref update",
      "type": "object",
    },
    "BranchName": {
      "description": "A short branch name, 1–255 characters, valid under git check-ref-format (no "..", "@{", "//", spaces, control characters or ~ ^ : ? * [ or backslash; no component starting with "." or ending with ".lock"; not starting with "-" or "refs/"; not "HEAD"; not 40 lowercase hex characters, which a Revision always reads as a commit id). The gateway stores it as refs/heads/<name>.",
      "examples": [
        "main",
        "staging",
        "feature/new-page",
      ],
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?!refs\\/)(?!HEAD$)(?![0-9a-f]{40}$)(?!@$)(?!.*\\.\\.)(?!.*@\\{)(?!.*\\/\\/)(?!.*\\/\\.)(?!.*\\.lock(?:\\/|$))(?!.*[./]$)[^\\x00-\\x20\\x7f~^:?*[\\\\.\\-/][^\\x00-\\x20\\x7f~^:?*[\\\\]*$",
      "title": "Branch name",
      "type": "string",
    },
    "BranchPermissions": {
      "additionalProperties": false,
      "description": "What the rule-based branch policy allows on a ref no rule matches. Defaults: anyone with write access, create and delete allowed, force pushes refused.",
      "examples": [
        {
          "create": true,
          "delete": true,
          "forcePush": false,
          "pushers": null,
        },
      ],
      "properties": {
        "create": {
          "default": true,
          "description": "Whether a push may create a ref; default true.",
          "type": "boolean",
        },
        "delete": {
          "default": true,
          "description": "Whether a push may delete a ref; default true.",
          "type": "boolean",
        },
        "forcePush": {
          "default": false,
          "description": "Whether a push may move a branch to a commit that does not contain its current head (a non-fast-forward, "git push --force") or move an existing tag; default false.",
          "type": "boolean",
        },
        "pushers": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalSelector",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "Who may update matching refs at all; null (the default) lets every principal the Authorizer allowed to write.",
        },
      },
      "title": "Branch permissions",
      "type": "object",
    },
    "BranchPolicyConfig": {
      "additionalProperties": false,
      "description": "Configuration of the reference rule-based BranchPolicy. Refs outside refs/heads/ and refs/tags/ are always refused, whatever the rules say.",
      "examples": [
        {
          "fallback": {
            "create": true,
            "delete": true,
            "forcePush": false,
            "pushers": null,
          },
          "rules": [
            {
              "create": true,
              "delete": false,
              "forcePush": false,
              "message": "main is protected",
              "pattern": "refs/heads/main",
              "pushers": {
                "roles": [
                  "maintainer",
                ],
                "subjects": [],
              },
            },
          ],
        },
      ],
      "properties": {
        "fallback": {
          "$ref": "#/$defs/BranchPermissions",
          "default": {
            "create": true,
            "delete": true,
            "forcePush": false,
            "pushers": null,
          },
          "description": "What applies to a branch or tag ref no rule matches; default anyone with write access, create and delete allowed, force refused.",
        },
        "rules": {
          "default": [],
          "description": "Rules tried in order; the first whose pattern matches a ref decides it. At most 200, default none.",
          "items": {
            "$ref": "#/$defs/BranchRule",
          },
          "maxItems": 200,
          "type": "array",
        },
      },
      "title": "Branch policy configuration",
      "type": "object",
    },
    "BranchRule": {
      "additionalProperties": false,
      "description": "Governs the refs matching \`pattern\`: who may push them, whether they may be created or deleted, and whether force pushes are allowed. Rules are tried in order and the first match decides.",
      "examples": [
        {
          "create": true,
          "delete": false,
          "forcePush": false,
          "message": "main is protected",
          "pattern": "refs/heads/main",
          "pushers": {
            "roles": [
              "maintainer",
            ],
            "subjects": [],
          },
        },
      ],
      "properties": {
        "create": {
          "default": true,
          "description": "Whether a push may create a matching ref; default true.",
          "type": "boolean",
        },
        "delete": {
          "default": false,
          "description": "Whether a push may delete a matching ref; default false (rules usually protect).",
          "type": "boolean",
        },
        "forcePush": {
          "default": false,
          "description": "Whether a push may move a matching branch to a commit that does not contain its current head, or move a matching tag; default false.",
          "type": "boolean",
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\n\\0]+$",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "Text git shows the user when this rule refuses an update, e.g. "main is protected"; one line of 1–200 characters. Null (the default) uses a message naming the ref and what was refused.",
        },
        "pattern": {
          "$ref": "#/$defs/RefPattern",
          "description": "The refs this rule governs.",
        },
        "pushers": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalSelector",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "Who may update matching refs at all; null (the default) lets every principal the Authorizer allowed to write.",
        },
      },
      "required": [
        "pattern",
      ],
      "title": "Branch rule",
      "type": "object",
    },
    "ChangedPath": {
      "additionalProperties": false,
      "description": "One path a pushed commit changed, from comparing its tree with its parent's: the change, the modes and ids on both sides, and the new blob's size.",
      "examples": [
        {
          "change": "modified",
          "newMode": "100644",
          "newSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "oldMode": "100644",
          "oldSha": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
          "path": "content/pages/about.md",
          "size": 1832,
        },
      ],
      "properties": {
        "change": {
          "description": "What the commit did to the path.",
          "enum": [
            "added",
            "modified",
            "deleted",
          ],
          "enumDescriptions": {
            "added": "The path is new: no entry before (a file replacing a directory is added too).",
            "deleted": "The path is gone (a directory replacing a file deletes the file).",
            "modified": "The path existed and its content or mode changed.",
          },
          "type": "string",
        },
        "newMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileMode",
            },
            {
              "type": "null",
            },
          ],
          "description": "The mode after the commit; null when the path was deleted.",
        },
        "newSha": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha",
            },
            {
              "type": "null",
            },
          ],
          "description": "The blob (or submodule commit) after the commit; null when deleted.",
        },
        "oldMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileMode",
            },
            {
              "type": "null",
            },
          ],
          "description": "The mode before the commit; null when the path was added.",
        },
        "oldSha": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha",
            },
            {
              "type": "null",
            },
          ],
          "description": "The blob (or submodule commit) before the commit; null when added.",
        },
        "path": {
          "description": "The file's path from the repository root, "/"-separated, exactly as the tree names it (any bytes git allows except NUL, decoded as UTF-8); 1–4096 characters. Always a file, symlink or submodule, never a directory: a directory added or removed appears as each file in it.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\0]+$",
          "type": "string",
        },
        "size": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            {
              "type": "null",
            },
          ],
          "description": "Size in bytes of the new blob (for a symlink, of its target text); null when the path was deleted or is a submodule (mode 160000).",
        },
      },
      "required": [
        "path",
        "change",
        "oldMode",
        "newMode",
        "oldSha",
        "newSha",
        "size",
      ],
      "title": "Changed path",
      "type": "object",
    },
    "ChmodAction": {
      "additionalProperties": false,
      "description": "Sets (true) or clears (false) the executable bit of an existing file. Fails with path_not_found if the path is not a file. Setting the bit it already has changes nothing.",
      "examples": [
        {
          "action": "chmod",
          "executeFilemode": true,
          "path": "scripts/build.sh",
        },
      ],
      "properties": {
        "action": {
          "const": "chmod",
          "description": "Set or clear the executable bit of an existing file.",
          "type": "string",
        },
        "executeFilemode": {
          "description": "true: mode 100755 (executable); false: mode 100644 (not executable).",
          "type": "boolean",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the existing file.",
        },
      },
      "required": [
        "action",
        "path",
        "executeFilemode",
      ],
      "title": "Chmod action",
      "type": "object",
    },
    "Commit": {
      "additionalProperties": false,
      "description": "A commit as stored in a repository, with its message trailer parsed out.",
      "examples": [
        {
          "author": {
            "date": "2026-11-20T09:30:00.000Z",
            "email": "ada@example.com",
            "name": "Ada Lovelace",
          },
          "committer": {
            "date": "2026-11-20T09:30:00.000Z",
            "email": "ada@example.com",
            "name": "Ada Lovelace",
          },
          "idempotencyKey": "cms:publish:2f9c1e",
          "message": "Update about page

Gateway-Idempotency-Key: cms:publish:2f9c1e
",
          "parents": [
            "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          ],
          "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        },
      ],
      "properties": {
        "author": {
          "$ref": "#/$defs/Signature",
          "description": "Who wrote the change, and when.",
        },
        "committer": {
          "$ref": "#/$defs/Signature",
          "description": "Who recorded the commit, and when; equals the author unless one was given.",
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdempotencyKey",
            },
            {
              "type": "null",
            },
          ],
          "description": "The key from the message's "Gateway-Idempotency-Key:" trailer, or null when the commit has none.",
        },
        "message": {
          "description": "Full commit message as stored, including any "Gateway-Idempotency-Key:" trailer the gateway appended.",
          "minLength": 1,
          "type": "string",
        },
        "parents": {
          "description": "Parent commit ids in order: empty for a root commit, one for an ordinary commit, two for a merge (the branch merged into first).",
          "items": {
            "$ref": "#/$defs/Sha",
            "description": "Id of a parent commit.",
          },
          "maxItems": 2,
          "type": "array",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "Id of this commit.",
        },
        "tree": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the root tree this commit records.",
        },
      },
      "required": [
        "sha",
        "tree",
        "parents",
        "author",
        "committer",
        "message",
        "idempotencyKey",
      ],
      "title": "Commit",
      "type": "object",
    },
    "CommitAction": {
      "description": "One change in a commit, discriminated by \`action\`. Actions apply in order, each to the result of the one before, with the GitLab Commits API semantics (plus upsert).",
      "examples": [
        {
          "action": "create",
          "content": "# About
",
          "encoding": "text",
          "path": "content/about.md",
        },
        {
          "action": "delete",
          "path": "content/old.md",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/CreateAction",
        },
        {
          "$ref": "#/$defs/UpdateAction",
        },
        {
          "$ref": "#/$defs/UpsertAction",
        },
        {
          "$ref": "#/$defs/DeleteAction",
        },
        {
          "$ref": "#/$defs/MoveAction",
        },
        {
          "$ref": "#/$defs/ChmodAction",
        },
      ],
      "title": "Commit action",
    },
    "CommitCommitted": {
      "additionalProperties": false,
      "description": "commit() wrote a new commit and moved the branch to it.",
      "examples": [
        {
          "commit": {
            "author": {
              "date": "2026-11-20T09:30:00.000Z",
              "email": "ada@example.com",
              "name": "Ada Lovelace",
            },
            "committer": {
              "date": "2026-11-20T09:30:00.000Z",
              "email": "ada@example.com",
              "name": "Ada Lovelace",
            },
            "idempotencyKey": "cms:publish:2f9c1e",
            "message": "Update about page

Gateway-Idempotency-Key: cms:publish:2f9c1e
",
            "parents": [
              "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            ],
            "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
          },
          "refUpdate": {
            "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            "ref": "refs/heads/staging",
          },
          "status": "committed",
        },
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/Commit",
          "description": "The commit written.",
        },
        "refUpdate": {
          "$ref": "#/$defs/RefUpdate",
          "description": "How the branch moved; oldSha is all zeros when the commit created it.",
        },
        "status": {
          "const": "committed",
          "description": "A new commit was written and the branch moved to it.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "commit",
        "refUpdate",
      ],
      "title": "commit: committed",
      "type": "object",
    },
    "CommitExistsInput": {
      "additionalProperties": false,
      "description": "Input of commitExists(): is this commit in the repository, optionally on a branch?",
      "examples": [
        {
          "branch": "main",
          "repo": "acme-raw-content",
          "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
        },
      ],
      "properties": {
        "branch": {
          "$ref": "#/$defs/BranchName",
          "description": "When given, the commit must also be reachable from this branch's head (the head itself or an ancestor). Absent: any commit in the repository counts.",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to look in.",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "Commit id to look for.",
        },
      },
      "required": [
        "repo",
        "sha",
      ],
      "title": "commitExists input",
      "type": "object",
    },
    "CommitExistsOutput": {
      "additionalProperties": false,
      "description": "Output of commitExists().",
      "examples": [
        {
          "exists": true,
        },
      ],
      "properties": {
        "exists": {
          "description": "true when the commit exists (and is reachable from \`branch\` when one was named); false otherwise, including when the branch does not exist.",
          "type": "boolean",
        },
      },
      "required": [
        "exists",
      ],
      "title": "commitExists output",
      "type": "object",
    },
    "CommitInput": {
      "additionalProperties": false,
      "description": "Input of commit(): a multi-file commit to one branch, built without a clone. Checked in this order: idempotency replay, then stale head, then the actions.",
      "examples": [
        {
          "actions": [
            {
              "action": "update",
              "content": "# About us
",
              "encoding": "text",
              "path": "content/about.md",
            },
          ],
          "author": {
            "email": "ada@example.com",
            "name": "Ada Lovelace",
          },
          "branch": "staging",
          "expectedHead": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "idempotencyKey": "cms:publish:2f9c1e",
          "message": "Update about page",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "actions": {
          "description": "Changes to apply, in order, each to the result of the previous; 1–1000 actions.",
          "items": {
            "$ref": "#/$defs/CommitAction",
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array",
        },
        "author": {
          "$ref": "#/$defs/Identity",
          "description": "Who wrote the change.",
        },
        "branch": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch to commit to. If it does not exist it is created: from \`startBranch\` when given, or as a root commit when the repository has no branches at all; otherwise the call fails with ref_not_found.",
        },
        "committer": {
          "$ref": "#/$defs/Identity",
          "description": "Who records the commit. Absent: the author.",
        },
        "expectedHead": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha",
            },
            {
              "type": "null",
            },
          ],
          "description": "Head the caller based its change on. When given and the branch head differs, the call fails with stale_head; null expects the branch not to exist yet. Absent: commit onto whatever the head is.",
        },
        "idempotencyKey": {
          "$ref": "#/$defs/IdempotencyKey",
          "description": "Makes the call safe to retry: if a commit with this key is in the branch's recent history, it is returned (status "replayed") and nothing is written.",
        },
        "message": {
          "description": "Commit message, 1–65536 characters and not blank. The gateway appends the idempotency trailer.",
          "maxLength": 65536,
          "minLength": 1,
          "type": "string",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Repository to commit to.",
        },
        "startBranch": {
          "$ref": "#/$defs/BranchName",
          "description": "Branch to start \`branch\` from when \`branch\` does not exist yet; ignored when it does. Absent: no start branch.",
        },
      },
      "required": [
        "repo",
        "branch",
        "message",
        "author",
        "actions",
        "idempotencyKey",
      ],
      "title": "commit input",
      "type": "object",
    },
    "CommitNoop": {
      "additionalProperties": false,
      "description": "commit() applied the actions and the resulting tree equals the head's, so nothing was written.",
      "examples": [
        {
          "head": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "status": "noop",
        },
      ],
      "properties": {
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha",
            },
            {
              "type": "null",
            },
          ],
          "description": "The branch head, unchanged; null when the branch does not exist.",
        },
        "status": {
          "const": "noop",
          "description": "The actions left the tree unchanged; nothing was written or pushed.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "head",
      ],
      "title": "commit: no-op",
      "type": "object",
    },
    "CommitOutput": {
      "description": "Output of commit(), discriminated by \`status\`.",
      "examples": [
        {
          "head": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "status": "noop",
        },
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/CommitCommitted",
        },
        {
          "$ref": "#/$defs/CommitReplayed",
        },
        {
          "$ref": "#/$defs/CommitNoop",
        },
        {
          "$ref": "#/$defs/CommitQueued",
        },
      ],
      "title": "commit output",
    },
    "CommitQueued": {
      "additionalProperties": false,
      "description": "commit() hit stale-head refusals more times than the inline retry budget and handed the commit to a CommitWorkflow with the same idempotency key. The in-memory reference never returns this.",
      "examples": [
        {
          "status": "queued",
          "workflowInstanceId": "commit-cms-publish-2f9c1e",
        },
      ],
      "properties": {
        "status": {
          "const": "queued",
          "description": "Inline retries ran out; a CommitWorkflow finishes the commit.",
          "type": "string",
        },
        "workflowInstanceId": {
          "description": "Id of the CommitWorkflow instance carrying the same idempotency key.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "status",
        "workflowInstanceId",
      ],
      "title": "commit: queued",
      "type": "object",
    },
    "CommitReplayed": {
      "additionalProperties": false,
      "description": "commit() found a commit with the same idempotency key in the branch's recent history and returned it without writing.",
      "examples": [
        {
          "commit": {
            "author": {
              "date": "2026-11-20T09:30:00.000Z",
              "email": "ada@example.com",
              "name": "Ada Lovelace",
            },
            "committer": {
              "date": "2026-11-20T09:30:00.000Z",
              "email": "ada@example.com",
              "name": "Ada Lovelace",
            },
            "idempotencyKey": "cms:publish:2f9c1e",
            "message": "Update about page

Gateway-Idempotency-Key: cms:publish:2f9c1e
",
            "parents": [
              "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
            ],
            "sha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
            "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
          },
          "status": "replayed",
        },
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/Commit",
          "description": "The earlier commit carrying the same idempotency key.",
        },
        "status": {
          "const": "replayed",
          "description": "A commit with the same idempotency key already exists; nothing was written.",
          "type": "string",
        },
      },
      "required": [
        "status",
        "commit",
      ],
      "title": "commit: replayed",
      "type": "object",
    },
    "ContentEncoding": {
      "description": "How file content is carried in a JSON string.",
      "enum": [
        "text",
        "base64",
      ],
      "enumDescriptions": {
        "base64": "The string is standard base64 (RFC 4648, with padding) of the raw file bytes; use for binary files.",
        "text": "The string is the file content itself, stored as UTF-8 bytes.",
      },
      "examples": [
        "text",
        "base64",
      ],
      "title": "Content encoding",
      "type": "string",
    },
    "CreateAction": {
      "additionalProperties": false,
      "description": "Creates a file that does not exist yet. Fails with path_exists if the path is a file or a directory, and with path_conflict if a parent is a file. The new file is not executable.",
      "examples": [
        {
          "action": "create",
          "content": "# About
",
          "encoding": "text",
          "path": "content/about.md",
        },
      ],
      "properties": {
        "action": {
          "const": "create",
          "description": "Create a new file. Fails with path_exists if the path exists.",
          "type": "string",
        },
        "content": {
          "$ref": "#/$defs/FileContent",
          "description": "Content of the new file, encoded as \`encoding\` says.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "default": "text",
          "description": "How \`content\` is encoded; defaults to "text".",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the file to create; it and every parent must not already be a file.",
        },
      },
      "required": [
        "action",
        "path",
        "content",
      ],
      "title": "Create action",
      "type": "object",
    },
    "CreateRepoInput": {
      "additionalProperties": false,
      "description": "Input of createRepo(): create an empty repository. Fails with repo_exists if the name is taken.",
      "examples": [
        {
          "defaultBranch": "main",
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "defaultBranch": {
          "$ref": "#/$defs/BranchName",
          "default": "main",
          "description": "Branch HEAD names; it comes into being with the first commit to it. Default "main".",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Name of the repository to create.",
        },
      },
      "required": [
        "repo",
      ],
      "title": "createRepo input",
      "type": "object",
    },
    "CreateRepoOutput": {
      "$ref": "#/$defs/RepoInfo",
      "description": "Output of createRepo(): the repository created, empty (no branches until the first commit).",
      "title": "createRepo output",
    },
    "CreateStorageRepoOptions": {
      "additionalProperties": false,
      "description": "Options of StorageBackend.createRepo(): how the empty repository is set up on the storage host.",
      "examples": [
        {
          "defaultBranch": "main",
        },
      ],
      "properties": {
        "defaultBranch": {
          "$ref": "#/$defs/BranchName",
          "default": "main",
          "description": "Branch the new repository's HEAD names. It holds no commits until the first push to it. Default "main".",
        },
      },
      "title": "Storage createRepo options",
      "type": "object",
    },
    "DeleteAction": {
      "additionalProperties": false,
      "description": "Deletes an existing file. Fails with path_not_found if the path is not a file (a directory cannot be deleted in one action).",
      "examples": [
        {
          "action": "delete",
          "path": "content/old.md",
        },
      ],
      "properties": {
        "action": {
          "const": "delete",
          "description": "Delete an existing file. Fails with path_not_found if it is absent.",
          "type": "string",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the file to delete. Directories left empty disappear with it.",
        },
      },
      "required": [
        "action",
        "path",
      ],
      "title": "Delete action",
      "type": "object",
    },
    "DeleteRepoInput": {
      "additionalProperties": false,
      "description": "Input of deleteRepo(): permanently delete a repository. Deleting a missing repository is not an error.",
      "examples": [
        {
          "repo": "acme-raw-content",
        },
      ],
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "Name of the repository to delete, with all its branches and history.",
        },
      },
      "required": [
        "repo",
      ],
      "title": "deleteRepo input",
      "type": "object",
    },
    "DeleteRepoOutput": {
      "additionalProperties": false,
      "description": "Output of deleteRepo().",
      "examples": [
        {
          "deleted": true,
        },
      ],
      "properties": {
        "deleted": {
          "description": "true when a repository was deleted; false when none had that name.",
          "type": "boolean",
        },
      },
      "required": [
        "deleted",
      ],
      "title": "deleteRepo output",
      "type": "object",
    },
    "FileContent": {
      "description": "File content as a string, interpreted according to the accompanying encoding: UTF-8 text, or base64 of the raw bytes. At most 48 MiB of characters (32 MiB of bytes as base64). An empty string is an empty file.",
      "examples": [
        "# Hello
",
        "iVBORw0KGgo=",
      ],
      "maxLength": 50331648,
      "title": "File content",
      "type": "string",
    },
    "FileMode": {
      "description": "The git mode of a tree entry, as the six-digit octal string git records.",
      "enum": [
        "100644",
        "100755",
        "120000",
        "160000",
        "040000",
      ],
      "enumDescriptions": {
        "040000": "A directory (a subtree).",
        "100644": "A regular file, not executable.",
        "100755": "A regular file with the executable bit set.",
        "120000": "A symbolic link; the blob holds the link target.",
        "160000": "A submodule; the id names a commit in another repository.",
      },
      "examples": [
        "100644",
        "040000",
      ],
      "title": "File mode",
      "type": "string",
    },
    "FilePath": {
      "description": "A path inside the repository relative to its root, 1–4096 characters, "/"-separated into segments of 1–255 characters: no leading or trailing "/", no empty, "." or ".." segment, no ".git" segment (any case), no backslash and no control character (U+0000–U+001F, U+007F). Case-sensitive; unicode allowed.",
      "examples": [
        "content/index.md",
        "templates/layouts/page.hbs",
      ],
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?!\\/)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?[^/]{256})(?!(?:.*\\/)?\\.\\.?(?:\\/|$))(?!(?:.*\\/)?\\.[gG][iI][tT](?:\\/|$))[^\\x00-\\x1f\\x7f\\\\]+$",
      "title": "File path",
      "type": "string",
    },
    "FileRead": {
      "additionalProperties": false,
      "description": "A file read from a repository at a commit, with its blob id, size and mode.",
      "examples": [
        {
          "commit": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "content": "# About us
",
          "encoding": "text",
          "executable": false,
          "path": "content/about.md",
          "sha": "f2a5b0a7d1d3d1f1c1c3e7e5d2b9b7e1a3c5d7e9",
          "size": 11,
        },
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the commit the file was read at (the ref resolved).",
        },
        "content": {
          "$ref": "#/$defs/ReadContent",
          "description": "The file's content, encoded as \`encoding\` says.",
        },
        "encoding": {
          "$ref": "#/$defs/ContentEncoding",
          "description": "How \`content\` is encoded; may be base64 even when text was requested.",
        },
        "executable": {
          "description": "true when the file mode is 100755.",
          "type": "boolean",
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Path of the file read.",
        },
        "sha": {
          "$ref": "#/$defs/Sha",
          "description": "Id of the file's blob. Equal content always has an equal id.",
        },
        "size": {
          "description": "Size of the file in bytes.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "path",
        "commit",
        "sha",
        "size",
        "executable",
        "encoding",
        "content",
      ],
      "title": "File read",
      "type": "object",
    },
    "FullRefName": {
      "description": "A fully qualified ref, "refs/heads/<branch>" or "refs/tags/<tag>", where the name after the prefix follows the same rules as a branch name.",
      "examples": [
        "refs/heads/main",
        "refs/tags/v1.0.0",
      ],
      "maxLength": 266,
      "minLength": 11,
      "pattern": "^refs\\/(?:heads|tags)\\/(?!@$)(?!.*\\.\\.)(?!.*@\\{)(?!.*\\/\\/)(?!.*\\/\\.)(?!.*\\.lock(?:\\/|$))(?!.*[./]$)[^\\x00-\\x20\\x7f~^:?*[\\\\.\\-/][^\\x00-\\x20\\x7f~^:?*[\\\\]*$",
      "title": "Full ref name",
      "type": "string",
    },
    "GatewayConfig": {
      "additionalProperties": false,
      "description": "Settings shared by every implementation of the RPC contract, the real gateway and the in-memory reference alike. Every field has a default, so {} is a complete configuration.",
      "examples": [
        {
          "authCacheSeconds": 60,
          "idempotency": {
            "maxAgeSeconds": 604800,
            "maxCommits": 200,
          },
          "inlineRetries": 3,
          "publicBaseUrl": "https://git.example.com",
          "serviceIdentity": {
            "email": "git-gateway@noreply.invalid",
            "name": "git-gateway",
          },
          "syncRules": [
            {
              "from": "main",
              "into": "staging",
            },
          ],
        },
      ],
      "properties": {
        "authCacheSeconds": {
          "default": 60,
          "description": "Seconds an authentication and authorization decision is cached per principal and repository; 0 disables caching; at most 3600, default 60.",
          "maximum": 3600,
          "minimum": 0,
          "type": "integer",
        },
        "idempotency": {
          "$ref": "#/$defs/IdempotencyConfig",
          "default": {
            "maxAgeSeconds": 604800,
            "maxCommits": 200,
          },
          "description": "Idempotency lookback window; defaults to 200 commits or 7 days.",
        },
        "inlineRetries": {
          "default": 3,
          "description": "Times a write is rebuilt and retried inline after a stale-head refusal before it is handed to a Workflow; 0–10, default 3.",
          "maximum": 10,
          "minimum": 0,
          "type": "integer",
        },
        "publicBaseUrl": {
          "default": "https://git.example.com",
          "description": "Origin (and optional path prefix) repositories are served under, without a trailing slash; a repository is at <publicBaseUrl>/<repo>.git. Default https://git.example.com.",
          "format": "uri",
          "type": "string",
        },
        "serviceIdentity": {
          "$ref": "#/$defs/Identity",
          "default": {
            "email": "git-gateway@noreply.invalid",
            "name": "git-gateway",
          },
          "description": "Author and committer of commits the gateway makes on its own behalf (sync merges) when the caller names none. Default git-gateway <git-gateway@noreply.invalid>.",
        },
        "syncRules": {
          "default": [],
          "description": "Branch syncs started after every accepted push to a rule's \`from\` branch, through the smart-HTTP proxy or an RPC write. The worker starts each as a SyncBranchWorkflow and refuses to start without that Workflow binding when any rule is set; the in-memory reference has no push hooks and ignores them. At most 50, default none.",
          "items": {
            "$ref": "#/$defs/SyncRule",
          },
          "maxItems": 50,
          "type": "array",
        },
      },
      "title": "Gateway configuration",
      "type": "object",
    },
    "GatewayError.invalid_input": {
      "additionalProperties": false,
      "description": "The call input failed schema validation; nothing was read or written.",
      "examples": [
        {
          "code": "invalid_input",
          "details": {
            "issues": [
              {
                "message": "Required",
                "path": "branch",
              },
            ],
          },
          "message": "Invalid input",
        },
      ],
      "properties": {
        "code": {
          "const": "invalid_input",
          "description": "The call input failed schema validation; nothing was read or written.",
          "type": "string",
        },
        "details": {
          "additionalProperties": false,
          "description": "Machine-readable facts about the invalid_input error.",
          "properties": {
            "issues": {
              "description": "Every validation failure found.",
              "items": {
                "additionalProperties": false,
                "description": "One validation failure.",
                "properties": {
                  "message": {
                    "description": "What is wrong with the value.",
                    "minLength": 1,
                    "type": "string",
                  },
                  "path": {
                    "description": "Dot-separated location of the bad value in the input; empty for the root.",
                    "type": "string",
                  },
                },
                "required": [
                  "path",
                  "message",
                ],
                "type": "object",
              },
              "minItems": 1,
              "type": "array",
            },
          },
          "required": [
            "issues",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "invalid_input error",
      "type": "object",
    },
    "GatewayError.not_fast_forward": {
      "additionalProperties": false,
      "description": "promote named a commit that does not contain the head of the target branch; nothing moved.",
      "examples": [
        {
          "code": "not_fast_forward",
