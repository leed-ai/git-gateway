{
  "$defs": {
    "AuditEvent": {
      "additionalProperties": false,
      "description": "Handed to the audit hook for every authenticated smart-HTTP request once it is decided: principal, repository, operation, refs and outcome. Never contains a credential.",
      "examples": [
        {
          "at": "2026-11-20T09:30:00.000Z",
          "endpoint": "receive-pack",
          "operation": "write",
          "outcome": "denied",
          "principal": {
            "email": null,
            "expiresAt": null,
            "name": null,
            "roles": [
              "editor",
            ],
            "subject": "user:42",
          },
          "reason": "main is protected",
          "refs": [
            {
              "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
              "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
              "reason": "main is protected",
              "ref": "refs/heads/main",
              "status": "rejected",
            },
          ],
          "repo": "acme-raw-content",
          "requestId": "6f1d2c3b-9a8e-4f7d-b6c5-a4e3d2c1b0a9",
        },
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the gateway finished deciding and forwarding the request.",
        },
        "endpoint": {
          "$ref": "#/$defs/SmartHttpEndpoint",
          "description": "Which smart-HTTP endpoint the request reached.",
        },
        "operation": {
          "$ref": "#/$defs/GitOperation",
          "description": "Whether the request reads or writes the repository.",
        },
        "outcome": {
          "description": "What the gateway did with the request.",
          "enum": [
            "allowed",
            "denied",
            "failed",
          ],
          "enumDescriptions": {
            "allowed": "Authorized and forwarded to storage; for a push, \`refs\` says what storage did with each ref.",
            "denied": "Refused by the authorizer or the branch policy; nothing reached storage.",
            "failed": "Authorized, but the gateway or the storage host failed before an answer was complete.",
          },
          "type": "string",
        },
        "principal": {
          "$ref": "#/$defs/Principal",
          "description": "Who made the request (never the credential).",
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Why the request was denied or failed, as the client was told; null when it was allowed.",
        },
        "refs": {
          "description": "For a push (receive-pack), every update command and its outcome; empty for every other request.",
          "items": {
            "$ref": "#/$defs/AuditRefOutcome",
          },
          "maxItems": 10000,
          "type": "array",
        },
        "repo": {
          "$ref": "#/$defs/RepoName",
          "description": "The repository the request named.",
        },
        "requestId": {
          "$ref": "#/$defs/RequestId",
          "description": "The request this event records.",
        },
      },
      "required": [
        "requestId",
        "at",
        "principal",
        "repo",
        "operation",
        "endpoint",
        "outcome",
        "reason",
        "refs",
      ],
      "title": "Audit event",
      "type": "object",
    },
    "AuditRefOutcome": {
      "additionalProperties": false,
      "description": "One update command of an audited push and what became of it.",
      "examples": [
        {
          "newSha": "8f3c2a9e1b7d4c6f0a5e2d9b8c7a6f5e4d3c2b1a",
          "oldSha": "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d",
          "reason": "main is protected",
          "ref": "refs/heads/main",
          "status": "rejected",
        },
      ],
      "properties": {
        "newSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the client asked the ref to name; all zeros when it asked to delete the ref.",
        },
        "oldSha": {
          "$ref": "#/$defs/Sha",
          "description": "Id the client said the ref named; all zeros when it asked to create the ref.",
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Why the update was refused, as git was told; null unless \`status\` is "rejected".",
        },
        "ref": {
          "description": "The ref the update command named, fully qualified; any namespace, since refused ones are audited too.",
          "maxLength": 4096,
          "minLength": 6,
          "pattern": "^refs\\/[^\\n\\0]+$",
          "type": "string",
        },
        "status": {
          "description": "What happened to the ref.",
          "enum": [
            "ok",
            "rejected",
            "unknown",
          ],
          "enumDescriptions": {
            "ok": "The storage host reported the ref updated.",
            "rejected": "The gateway or the storage host refused the update; \`reason\` says why.",
            "unknown": "The push was forwarded but the storage host report could not be read.",
          },
          "type": "string",
        },
      },
      "required": [
        "ref",
        "oldSha",
        "newSha",
        "status",
        "reason",
      ],
      "title": "Audited ref update",
      "type": "object",
    },
    "BranchName": {
      "description": "A short branch name, 1–255 characters, valid under git check-ref-format (no "..", "@{", "//", spaces, control characters or ~ ^ : ? * [ or backslash; no component starting with "." or ending with ".lock"; not starting with "-" or "refs/"; not "HEAD"; not 40 lowercase hex characters, which a Revision always reads as a commit id). The gateway stores it as refs/heads/<name>.",
      "examples": [
        "main",
        "staging",
        "feature/new-page",
      ],
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?!refs\\/)(?!HEAD$)(?![0-9a-f]{40}$)(?!@$)(?!.*\\.\\.)(?!.*@\\{)(?!.*\\/\\/)(?!.*\\/\\.)(?!.*\\.lock(?:\\/|$))(?!.*[./]$)[^\\x00-\\x20\\x7f~^:?*[\\\\.\\-/][^\\x00-\\x20\\x7f~^:?*[\\\\]*$",
      "title": "Branch name",
      "type": "string",
    },
    "BranchPermissions": {
      "additionalProperties": false,
      "description": "What the rule-based branch policy allows on a ref no rule matches. Defaults: anyone with write access, create and delete allowed, force pushes refused.",
      "examples": [
        {
          "create": true,
          "delete": true,
          "forcePush": false,
          "pushers": null,
        },
      ],
      "properties": {
        "create": {
          "default": true,
          "description": "Whether a push may create a ref; default true.",
          "type": "boolean",
        },
        "delete": {
          "default": true,
          "description": "Whether a push may delete a ref; default true.",
          "type": "boolean",
        },
        "forcePush": {
          "default": false,
          "description": "Whether a push may move a branch to a commit that does not contain its current head (a non-fast-forward, "git push --force") or move an existing tag; default false.",
          "type": "boolean",
        },
        "pushers": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalSelector",
            },
            {
              "type": "null",
            },
          ],
          "default": null,
          "description": "Who may update matching refs at all; null (the default) lets every principal the Authorizer allowed to write.",
        },
      },
      "required": [
        "pushers",
        "create",
        "delete",
        "forcePush",
      ],
      "title": "Branch permissions",
      "type": "object",
    },
    "BranchPolicyConfig": {
      "additionalProperties": false,
      "description": "Configuration of the reference rule-based BranchPolicy. Refs outside refs/heads/ and refs/tags/ are always refused, whatever the rules say.",
      "examples": [
        {
          "fallback": {
            "create": true,
            "delete": true,
            "forcePush": false,
            "pushers": null,
          },
          "rules": [
            {
              "create": true,
              "delete": false,
              "forcePush": false,
              "message": "main is protected",
              "pattern": "refs/heads/main",
              "pushers": {
                "roles": [
                  "maintainer",
                ],
                "subjects": [],
              },
            },
          ],
        },
      ],
      "properties": {
        "fallback": {
          "$ref": "#/$defs/BranchPermissions",
          "default": {
            "create": true,
            "delete": true,
            "forcePush": false,
            "pushers": null,
          },
          "description": "What applies to a branch or tag ref no rule matches; default anyone with write access, create and delete allowed, force refused.",
        },
        "rules": {
          "default": [],
          "description": "Rules tried in order; the first whose pattern matches a ref decides it. At most 200, default none.",
          "items": {
            "$ref": "#/$defs/BranchRule",
          },
          "maxItems": 200,
          "type": "array",
        },
      },
      "required": [
        "rules",
        "fallback",
      ],
      "title": "Branch policy configuration",
      "type": "object",
    },
    "BranchRule": {
      "additionalProperties": false,
      "description": "Governs the refs matching \`pattern\`: who may push them, whether they may be created or deleted, and whether force pushes are allowed. Rules are tried in order and the first match decides.",
      "examples": [
        {
          "create": true,
          "delete": false,
          "forcePush": false,
          "message": "main is protected",
          "pattern": "refs/heads/main",
          "pushers": {
            "roles": [
              "maintainer",
            ],
            "subjects": [],
          },
        },
      ],
      "properties": {
        "create": {
          "default": true,
          "description": "Whether a push may create a matching ref; default true.",
          "type": "boolean",
        },
        "delete": {
          "default": false,
          "description": "Whether a push may delete a matching ref; default false (rules usually protect).",
          "type": "boolean",
        },
        "forcePush": {
          "default": false,
          "description": "Whether a push may move a matching branch to a commit that does not contain its current head, or move a matching tag; default false.",
          "type": "boolean",
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
