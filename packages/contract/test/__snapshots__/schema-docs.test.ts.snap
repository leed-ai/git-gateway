            },
          },
          "required": [
            "into",
            "sha",
            "head",
          ],
          "type": "object",
        },
        "message": {
          "description": "Human-readable explanation, safe to show to an end user.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "code",
        "message",
        "details",
      ],
      "title": "not_fast_forward error",
      "type": "object",
    },
    "GatewayError.not_head_of_source": {
      "additionalProperties": false,
      "description": "promote named a commit that is not the current head of the source branch; nothing moved.",
      "examples": [
